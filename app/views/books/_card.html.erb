<div class="group">
  <div class="aspect-[3/4] rounded-md overflow-hidden bg-stone-100 mb-4">
    <% if book.cover.attached? %>
      <%= image_tag book.cover, class: "w-full h-full object-cover", alt: book.title %>
    <% else %>
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-b from-stone-100 to-stone-200 p-6">
        <p class="text-center text-stone-600 font-bold leading-tight" style="font-family: 'Source Serif 4', Georgia, serif;"><%= book.title %></p>
      </div>
    <% end %>
  </div>
  <h3 class="font-semibold text-stone-900 text-sm"><%= book.title %></h3>
  <% if book.published_year %>
    <p class="text-xs text-stone-400 mt-0.5"><%= book.published_year %></p>
  <% end %>
  <% if book.description.present? %>
    <p class="text-sm text-stone-500 mt-2 leading-relaxed line-clamp-2"><%= book.description %></p>
  <% end %>
  <% if book.buy_url.present? %>
    <%= link_to "Buy &rarr;".html_safe, book.buy_url, target: "_blank", rel: "noopener", class: "inline-block mt-3 text-sm font-medium text-stone-800 hover:text-stone-500 transition-colors" %>
  <% end %>
</div>
