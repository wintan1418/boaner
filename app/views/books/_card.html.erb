<%
  placeholder_covers = [
    "https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=400&h=560&q=80&auto=format&fit=crop",
    "https://images.unsplash.com/photo-1512820790803-83ca734da794?w=400&h=560&q=80&auto=format&fit=crop",
    "https://images.unsplash.com/photo-1543002588-bfa74002ed7e?w=400&h=560&q=80&auto=format&fit=crop",
  ]
  cover_index = book.id.to_i % 3
%>

<div class="group">
  <!-- Book cover with 3D tilt effect -->
  <div class="relative mx-auto w-48 mb-6" style="perspective: 800px;">
    <div class="relative transition-transform duration-500 group-hover:rotate-y-[-8deg]" style="transform-style: preserve-3d;">
      <!-- Spine shadow -->
      <div class="absolute left-0 top-2 bottom-2 w-3 bg-gradient-to-r from-black/30 to-transparent rounded-l-sm"></div>
      <!-- Cover -->
      <div class="aspect-[2/3] rounded-lg overflow-hidden shadow-xl ring-1 ring-black/10 group-hover:shadow-2xl transition-shadow duration-500">
        <% if book.cover.attached? %>
          <%= image_tag book.cover, class: "w-full h-full object-cover", alt: book.title %>
        <% else %>
          <img src="<%= placeholder_covers[cover_index] %>"
               alt="<%= book.title %>"
               class="w-full h-full object-cover"
               loading="lazy">
        <% end %>
      </div>
      <!-- Bottom page edges -->
      <div class="absolute bottom-0 left-1 right-1 h-2 bg-gradient-to-b from-gray-200 to-gray-300 rounded-b-sm -mb-1"></div>
    </div>
  </div>

  <!-- Book info -->
  <div class="text-center">
    <h3 class="font-bold text-white text-lg leading-tight" style="font-family: 'Source Serif 4', Georgia, serif;"><%= book.title %></h3>
    <% if book.published_year %>
      <p class="text-amber-400/70 text-sm mt-1"><%= book.published_year %></p>
    <% end %>
    <% if book.description.present? %>
      <p class="text-gray-400 text-sm mt-2 leading-relaxed line-clamp-2 max-w-xs mx-auto"><%= book.description %></p>
    <% end %>
    <% if book.buy_url.present? %>
      <%= link_to book.buy_url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 mt-4 px-6 py-2.5 btn-amber text-white text-sm font-semibold rounded-lg" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
        Buy Now
      <% end %>
    <% end %>
  </div>
</div>
