<%
  # Placeholder cover images for books without uploaded covers
  placeholder_covers = [
    "https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=400&h=600&q=80&auto=format&fit=crop",
    "https://images.unsplash.com/photo-1512820790803-83ca734da794?w=400&h=600&q=80&auto=format&fit=crop",
    "https://images.unsplash.com/photo-1543002588-bfa74002ed7e?w=400&h=600&q=80&auto=format&fit=crop",
  ]
  cover_index = defined?(book_counter) ? book_counter.to_i % 3 : book.id.to_i % 3
%>

<div class="group card-hover">
  <div class="aspect-[2/3] rounded-xl overflow-hidden mb-5 shadow-lg ring-1 ring-white/10 relative">
    <% if book.cover.attached? %>
      <%= image_tag book.cover, class: "w-full h-full object-cover thumbnail-zoom", alt: book.title %>
    <% else %>
      <img src="<%= placeholder_covers[cover_index] %>"
           alt="<%= book.title %>"
           class="w-full h-full object-cover thumbnail-zoom"
           loading="lazy">
      <!-- Title overlay on placeholder -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end p-5">
        <p class="text-white font-bold text-lg leading-tight" style="font-family: 'Source Serif 4', Georgia, serif;"><%= book.title %></p>
      </div>
    <% end %>
  </div>
  <h3 class="font-bold text-white text-base" style="font-family: 'Source Serif 4', Georgia, serif;"><%= book.title %></h3>
  <% if book.published_year %>
    <p class="text-sm text-gray-500 mt-1"><%= book.published_year %></p>
  <% end %>
  <% if book.description.present? %>
    <p class="text-sm text-gray-400 mt-2 leading-relaxed line-clamp-2"><%= book.description %></p>
  <% end %>
  <% if book.buy_url.present? %>
    <%= link_to book.buy_url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 mt-4 px-5 py-2.5 btn-amber text-white text-sm font-semibold rounded-lg" do %>
      Buy Now
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
    <% end %>
  <% end %>
</div>
