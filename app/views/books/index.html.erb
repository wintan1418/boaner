<% content_for(:title) { "Books — Boaner" } %>

<!-- Dark themed section -->
<section class="bg-gray-950 min-h-screen hero-pattern relative overflow-hidden">
  <div class="absolute top-20 right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-20 w-64 h-64 bg-orange-500/8 rounded-full blur-3xl"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 relative">
    <h1 class="text-4xl md:text-5xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">Books</h1>
    <p class="mt-3 text-gray-400 text-lg">Published works.</p>
    <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-4"></div>

    <% if @books.any? %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-14">
        <% @books.each do |book| %>
          <div data-controller="animate">
            <%= render "books/card", book: book %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-20 mt-10 bg-gray-900 rounded-2xl border border-gray-800">
        <svg class="w-12 h-12 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        <p class="text-gray-500 font-medium">Books coming soon.</p>
      </div>
    <% end %>
  </div>
</section>
