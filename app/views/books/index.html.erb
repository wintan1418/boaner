<% content_for(:title) { "Books — Boaner" } %>

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
  <div class="mb-10">
    <h1 class="text-3xl font-bold text-stone-900" style="font-family: 'Source Serif 4', Georgia, serif;">Books</h1>
    <p class="mt-1 text-stone-400">Published works.</p>
  </div>

  <% if @books.any? %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @books.each do |book| %>
        <div data-controller="animate">
          <%= render "books/card", book: book %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-stone-400 py-12 text-center">Books coming soon.</p>
  <% end %>
</section>
