<% content_for(:title) { "Books — Boaner" } %>

<!-- Hero Header -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0">
    <img src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?w=1920&q=80&auto=format&fit=crop" alt="" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-gray-950/85"></div>
  </div>
  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 py-16 md:py-20">
    <h1 class="text-4xl md:text-5xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">Books</h1>
    <p class="mt-3 text-gray-300 text-lg">Published works and writing projects.</p>
    <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-4"></div>
  </div>
</section>

<!-- Books Grid -->
<section class="relative py-20 overflow-hidden">
  <div class="absolute inset-0">
    <img src="https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=1920&q=80&auto=format&fit=crop" alt="" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-gray-950/92"></div>
  </div>

  <div class="relative max-w-5xl mx-auto px-6 sm:px-8 lg:px-12">
    <% if @books.any? %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-12">
        <% @books.each do |book| %>
          <div data-controller="animate">
            <%= render "books/card", book: book %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-20 bg-gray-900/50 backdrop-blur rounded-2xl border border-gray-800">
        <p class="text-gray-500 font-medium">Books coming soon.</p>
      </div>
    <% end %>
  </div>
</section>
