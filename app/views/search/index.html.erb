<% content_for(:title) { "Search — Boaner" } %>

<!-- Hero Header -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-gray-950"></div>
  <div class="relative max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 py-16 md:py-20">
    <h1 class="text-4xl md:text-5xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">Search</h1>
    <p class="mt-3 text-gray-300 text-lg">Find videos, posts, and books.</p>
    <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-4"></div>

    <form action="/search" method="get" class="mt-8 max-w-xl">
      <div class="relative">
        <input type="text" name="q" value="<%= @query %>" placeholder="Search..." autofocus
               class="w-full px-5 py-3.5 pr-12 rounded-xl bg-white/10 border border-white/20 text-white placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 backdrop-blur">
        <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-amber-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </button>
      </div>
    </form>
  </div>
</section>

<section class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 py-12 md:py-16">
  <% if @query.blank? %>
    <div class="text-center py-20">
      <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <p class="text-gray-400 font-medium">Enter a search term to get started.</p>
    </div>
  <% elsif @videos.empty? && @posts.empty? && @books.empty? %>
    <div class="text-center py-20">
      <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <p class="text-gray-500 font-medium">No results found for "<%= @query %>"</p>
      <p class="text-gray-400 text-sm mt-1">Try a different search term.</p>
    </div>
  <% else %>
    <% if @videos.any? %>
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">Videos</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @videos.each do |video| %>
            <%= link_to video_path(video), class: "group block" do %>
              <div class="relative aspect-video rounded-xl overflow-hidden bg-gray-100 mb-3">
                <img src="<%= video.thumbnail_url_hq %>" alt="<%= video.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                  <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-lg">
                    <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </div>
              </div>
              <h3 class="text-sm font-semibold text-gray-900 group-hover:text-amber-600 transition-colors line-clamp-2"><%= video.title %></h3>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @posts.any? %>
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">Blog Posts</h2>
        <div class="space-y-4">
          <% @posts.each do |post| %>
            <%= link_to post_path(post), class: "group block p-5 bg-white rounded-xl border border-gray-100 hover:border-amber-200 hover:shadow-md transition-all duration-300" do %>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-base font-semibold text-gray-900 group-hover:text-amber-600 transition-colors"><%= post.title %></h3>
                  <% if post.excerpt.present? %>
                    <p class="mt-1 text-sm text-gray-500 line-clamp-2"><%= post.excerpt %></p>
                  <% end %>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-amber-500 shrink-0 mt-0.5 transform group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @books.any? %>
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">Books</h2>
        <div class="space-y-4">
          <% @books.each do |book| %>
            <div class="p-5 bg-white rounded-xl border border-gray-100">
              <h3 class="text-base font-semibold text-gray-900"><%= book.title %></h3>
              <% if book.description.present? %>
                <p class="mt-1 text-sm text-gray-500"><%= book.description %></p>
              <% end %>
              <% if book.buy_url.present? %>
                <%= link_to "View Book", book.buy_url, target: "_blank", class: "mt-3 inline-flex items-center text-sm font-medium text-amber-600 hover:text-amber-700" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</section>
