<div data-controller="reveal" class="fixed inset-0 z-[9999]">
  <!-- Main overlay -->
  <div data-reveal-target="overlay"
       class="fixed inset-0 bg-gray-950 flex items-center justify-center transition-colors duration-200"
       style="clip-path: circle(150% at 50% 50%);">

    <!-- Rain canvas -->
    <canvas data-reveal-target="canvas" class="absolute inset-0 z-0"></canvas>

    <!-- Content -->
    <div class="relative z-10 text-center px-6 max-w-3xl mx-auto">
      <!-- Happy Birthday -->
      <h1 data-reveal-target="text1"
          class="text-5xl md:text-7xl lg:text-8xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500 opacity-0 scale-50 transition-all duration-1000 ease-out"
          style="font-family: 'Source Serif 4', Georgia, serif;">
        Happy Birthday
      </h1>

      <!-- Son of Thunder -->
      <h2 data-reveal-target="text2"
          class="text-3xl md:text-5xl lg:text-6xl font-bold text-white mt-4 opacity-0 translate-y-8 transition-all duration-800 ease-out"
          style="font-family: 'Source Serif 4', Georgia, serif;">
        Son of <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-500">Thunder</span>
      </h2>

      <!-- Thunder emojis line -->
      <div data-reveal-target="text3" class="opacity-0 transition-opacity duration-500 mt-6">
        <p class="text-4xl md:text-5xl tracking-widest">⚡🌩️⚡</p>
      </div>

      <!-- Subtitle -->
      <p data-reveal-target="subtitle"
         class="text-gray-400 text-lg md:text-xl mt-8 opacity-0 translate-y-4 transition-all duration-700 leading-relaxed max-w-lg mx-auto">
        This website was built with love as a birthday gift for you.
        <br>
        <span class="text-amber-400/80">May your stories thunder across the world.</span>
      </p>

      <!-- Enter button -->
      <div data-reveal-target="cta" class="opacity-0 scale-90 transition-all duration-500 mt-10">
        <button data-action="click->reveal#enter"
                class="group relative px-10 py-4 bg-gradient-to-r from-amber-500 to-orange-500 text-gray-900 font-bold text-lg rounded-2xl shadow-2xl shadow-amber-500/30 hover:shadow-amber-500/50 transition-all hover:scale-105 cursor-pointer">
          <span class="relative z-10 flex items-center gap-3">
            <span>Enter Your Kingdom</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </span>
        </button>
        <p class="text-gray-600 text-xs mt-4">Click to unveil your site</p>
      </div>
    </div>
  </div>
</div>
