<% if @settings.profile_image.attached? %>
  <%= image_tag @settings.profile_image, class: "w-full h-full object-cover", alt: @settings.site_name %>
<% else %>
  <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&q=80&auto=format&fit=crop&crop=face"
       alt="Profile photo"
       class="w-full h-full object-cover">
<% end %>
