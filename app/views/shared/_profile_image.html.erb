<% if @settings.profile_image.attached? %>
  <%= image_tag @settings.profile_image, class: "w-full h-full object-cover", alt: @settings.site_name %>
<% else %>
  <svg viewBox="0 0 400 500" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
    <rect width="400" height="500" fill="#e8e4df"/>
    <rect width="400" height="500" fill="url(#subtle)" opacity="0.5"/>
    <defs>
      <linearGradient id="subtle" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ddd9cf"/>
        <stop offset="100%" stop-color="#c4bfb1"/>
      </linearGradient>
    </defs>
    <!-- Silhouette -->
    <ellipse cx="200" cy="200" rx="62" ry="72" fill="#c4bfb1"/>
    <rect x="178" y="262" width="44" height="30" rx="8" fill="#c4bfb1"/>
    <ellipse cx="200" cy="380" rx="110" ry="65" fill="#c4bfb1"/>
    <ellipse cx="200" cy="155" rx="65" ry="48" fill="#a39d8e"/>
    <ellipse cx="148" cy="192" rx="14" ry="28" fill="#a39d8e"/>
    <ellipse cx="252" cy="192" rx="14" ry="28" fill="#a39d8e"/>
    <text x="200" y="470" text-anchor="middle" fill="#857e6e" font-size="13" font-family="Georgia, serif" letter-spacing="2">PHOTO COMING SOON</text>
  </svg>
<% end %>
