<% if @settings.profile_image.attached? %>
  <%= image_tag @settings.profile_image, class: "w-full h-full object-cover", alt: @settings.site_name %>
<% else %>
  <div class="w-full h-full bg-gradient-to-br from-amber-500 via-orange-500 to-amber-600 flex flex-col items-center justify-center">
    <svg class="w-24 h-24 text-white/40" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
    </svg>
    <p class="text-xs text-white/60 mt-2 tracking-widest uppercase font-medium">Photo coming soon</p>
  </div>
<% end %>
