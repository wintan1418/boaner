<% if @settings.profile_image.attached? %>
  <%= image_tag @settings.profile_image, class: "w-full h-full object-cover", alt: @settings.site_name %>
<% else %>
  <div class="w-full h-full bg-gradient-to-b from-stone-200 to-stone-300 flex flex-col items-center justify-center">
    <svg class="w-24 h-24 text-stone-400" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
    </svg>
    <p class="text-xs text-stone-500 mt-2 tracking-wide uppercase">Photo coming soon</p>
  </div>
<% end %>
