<footer class="border-t border-ink-100 mt-auto">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <p class="text-lg font-bold text-ink-900 tracking-tight" style="font-family: 'Source Serif 4', Georgia, serif;">boaner</p>
        <p class="mt-2 text-sm text-ink-400 max-w-xs leading-relaxed">
          <%= @settings.bio_short %>
        </p>

        <% if @settings.youtube_url.present? || @settings.twitter_url.present? || @settings.instagram_url.present? || @settings.linkedin_url.present? %>
          <div class="flex items-center gap-4 mt-4">
            <% if @settings.youtube_url.present? %>
              <%= link_to @settings.youtube_url, target: "_blank", rel: "noopener", class: "text-ink-300 hover:text-ink-600 transition-colors", title: "YouTube" do %>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/></svg>
              <% end %>
            <% end %>
            <% if @settings.twitter_url.present? %>
              <%= link_to @settings.twitter_url, target: "_blank", rel: "noopener", class: "text-ink-300 hover:text-ink-600 transition-colors", title: "X/Twitter" do %>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <% end %>
            <% end %>
            <% if @settings.instagram_url.present? %>
              <%= link_to @settings.instagram_url, target: "_blank", rel: "noopener", class: "text-ink-300 hover:text-ink-600 transition-colors", title: "Instagram" do %>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C16.67.014 16.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              <% end %>
            <% end %>
            <% if @settings.linkedin_url.present? %>
              <%= link_to @settings.linkedin_url, target: "_blank", rel: "noopener", class: "text-ink-300 hover:text-ink-600 transition-colors", title: "LinkedIn" do %>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-ink-400 uppercase tracking-widest mb-3">Explore</h4>
        <ul class="space-y-2 text-sm text-ink-500">
          <li><%= link_to "Videos", videos_path, class: "hover:text-ink-800 transition-colors" %></li>
          <li><%= link_to "Blog", posts_path, class: "hover:text-ink-800 transition-colors" %></li>
          <li><%= link_to "Courses", courses_path, class: "hover:text-ink-800 transition-colors" %></li>
          <li><%= link_to "Books", books_path, class: "hover:text-ink-800 transition-colors" %></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-ink-400 uppercase tracking-widest mb-3">Connect</h4>
        <ul class="space-y-2 text-sm text-ink-500">
          <li><%= link_to "About", about_path, class: "hover:text-ink-800 transition-colors" %></li>
          <li><%= link_to "Contact", contact_path, class: "hover:text-ink-800 transition-colors" %></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-ink-100 mt-8 pt-6 text-xs text-ink-300">
      &copy; <%= Date.current.year %> Boaner. All rights reserved.
    </div>
  </div>
</footer>
