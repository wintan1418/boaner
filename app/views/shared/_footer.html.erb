<!-- Gradient top border -->
<footer class="bg-gray-900 mt-auto relative">
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600"></div>

  <div class="max-w-5xl mx-auto px-6 sm:px-8 pt-16 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">
      <!-- Brand column — full width on mobile -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-2.5 mb-4 justify-center md:justify-start">
          <%= render "shared/logo", size: "sm" %>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed max-w-sm text-center md:text-left mx-auto md:mx-0">
          <%= @settings.bio_short %>
        </p>

        <!-- Social icons -->
        <% if @settings.youtube_url.present? || @settings.twitter_url.present? || @settings.instagram_url.present? || @settings.linkedin_url.present? %>
          <div class="flex items-center gap-3 mt-6 justify-center md:justify-start">
            <% if @settings.youtube_url.present? %>
              <%= link_to @settings.youtube_url, target: "_blank", rel: "noopener", class: "w-10 h-10 rounded-lg bg-gray-800 hover:bg-amber-500 flex items-center justify-center text-gray-400 hover:text-white transition-all duration-300", title: "YouTube" do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/></svg>
              <% end %>
            <% end %>
            <% if @settings.twitter_url.present? %>
              <%= link_to @settings.twitter_url, target: "_blank", rel: "noopener", class: "w-10 h-10 rounded-lg bg-gray-800 hover:bg-amber-500 flex items-center justify-center text-gray-400 hover:text-white transition-all duration-300", title: "X/Twitter" do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <% end %>
            <% end %>
            <% if @settings.instagram_url.present? %>
              <%= link_to @settings.instagram_url, target: "_blank", rel: "noopener", class: "w-10 h-10 rounded-lg bg-gray-800 hover:bg-amber-500 flex items-center justify-center text-gray-400 hover:text-white transition-all duration-300", title: "Instagram" do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C16.67.014 16.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              <% end %>
            <% end %>
            <% if @settings.linkedin_url.present? %>
              <%= link_to @settings.linkedin_url, target: "_blank", rel: "noopener", class: "w-10 h-10 rounded-lg bg-gray-800 hover:bg-amber-500 flex items-center justify-center text-gray-400 hover:text-white transition-all duration-300", title: "LinkedIn" do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Navigation columns — 2-column grid on mobile, separate on desktop -->
      <div class="grid grid-cols-2 md:contents gap-8">
        <!-- Explore column -->
        <div class="md:col-span-2">
          <h4 class="text-xs font-semibold text-amber-500 uppercase tracking-widest mb-4">Explore</h4>
          <ul class="space-y-3 text-sm">
            <li><%= link_to "Videos", videos_path, class: "text-gray-400 hover:text-amber-400 transition-colors" %></li>
            <li><%= link_to "Blog", posts_path, class: "text-gray-400 hover:text-amber-400 transition-colors" %></li>
            <li><%= link_to "Courses", courses_path, class: "text-gray-400 hover:text-amber-400 transition-colors" %></li>
            <li><%= link_to "Books", books_path, class: "text-gray-400 hover:text-amber-400 transition-colors" %></li>
          </ul>
        </div>

        <!-- Connect column -->
        <div class="md:col-span-2">
          <h4 class="text-xs font-semibold text-amber-500 uppercase tracking-widest mb-4">Connect</h4>
          <ul class="space-y-3 text-sm">
            <li><%= link_to "About", about_path, class: "text-gray-400 hover:text-amber-400 transition-colors" %></li>
            <li><%= link_to "Contact", contact_path, class: "text-gray-400 hover:text-amber-400 transition-colors" %></li>
          </ul>
        </div>
      </div>

      <!-- Contact column -->
      <div class="md:col-span-3 text-center md:text-left">
        <h4 class="text-xs font-semibold text-amber-500 uppercase tracking-widest mb-4">Get in Touch</h4>
        <p class="text-sm text-gray-400 mb-4"><%= @settings.email %></p>
        <%= link_to "Send a message &rarr;".html_safe, contact_path, class: "inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-amber-400 border border-amber-500/30 rounded-lg hover:bg-amber-500/10 transition-all" %>
      </div>
    </div>

