<header class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-gray-200/50 transition-shadow duration-300" data-controller="navbar">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <%= link_to root_path, class: "flex items-center gap-2.5 shrink-0 group" do %>
        <span class="w-9 h-9 bg-gradient-to-br from-amber-500 to-amber-600 rounded-lg flex items-center justify-center shadow-md shadow-amber-500/20 group-hover:shadow-amber-500/40 transition-shadow">
          <span class="text-white font-bold text-sm" style="font-family: 'Source Serif 4', Georgia, serif;">B</span>
        </span>
        <span class="text-[1.2rem] font-bold text-gray-900 tracking-tight" style="font-family: 'Source Serif 4', Georgia, serif;">Boaner</span>
      <% end %>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        <%= nav_link "Videos", videos_path %>
        <%= nav_link "Blog", posts_path %>
        <%= nav_link "Courses", courses_path %>
        <%= nav_link "Books", books_path %>
        <%= nav_link "About", about_path %>
        <%= link_to "Contact", contact_path, class: "ml-3 px-5 py-2 text-sm font-semibold rounded-lg transition-all duration-300 #{current_page?(contact_path) ? 'btn-amber text-white' : 'btn-amber text-white'}" %>
      </nav>

      <!-- Mobile Toggle -->
      <button data-action="click->navbar#toggle" class="md:hidden p-2 -mr-2 text-gray-600 hover:text-amber-600 transition-colors" aria-label="Menu">
        <svg data-navbar-target="openIcon" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
        </svg>
        <svg data-navbar-target="closeIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div data-navbar-target="menu" class="hidden md:hidden bg-white/95 backdrop-blur-xl border-t border-gray-100">
    <div class="px-4 py-4 space-y-1">
      <%= mobile_nav_link "Videos", videos_path %>
      <%= mobile_nav_link "Blog", posts_path %>
      <%= mobile_nav_link "Courses", courses_path %>
      <%= mobile_nav_link "Books", books_path %>
      <%= mobile_nav_link "About", about_path %>
      <div class="pt-2">
        <%= link_to "Contact", contact_path, class: "block text-center px-5 py-2.5 btn-amber text-white text-sm font-semibold rounded-lg" %>
      </div>
    </div>
  </div>
</header>
