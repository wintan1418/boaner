<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-stone-200" data-controller="navbar">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <%= link_to root_path, class: "flex items-center gap-2.5 shrink-0" do %>
        <span class="w-8 h-8 bg-stone-900 rounded-md flex items-center justify-center">
          <span class="text-white font-bold text-sm" style="font-family: Georgia, serif;">B</span>
        </span>
        <span class="text-[1.15rem] font-bold text-stone-900 tracking-tight" style="font-family: Georgia, serif;">Boaner</span>
      <% end %>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        <%= nav_link "Videos", videos_path %>
        <%= nav_link "Blog", posts_path %>
        <%= nav_link "Courses", courses_path %>
        <%= nav_link "Books", books_path %>
        <%= nav_link "About", about_path %>
        <%= link_to "Contact", contact_path, class: "ml-3 px-4 py-1.5 text-sm font-medium rounded-md #{current_page?(contact_path) ? 'bg-stone-900 text-white' : 'bg-stone-100 text-stone-700 hover:bg-stone-200 transition-colors'}" %>
      </nav>

      <!-- Mobile Toggle -->
      <button data-action="click->navbar#toggle" class="md:hidden p-2 -mr-2 text-stone-500 hover:text-stone-800" aria-label="Menu">
        <svg data-navbar-target="openIcon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
        </svg>
        <svg data-navbar-target="closeIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div data-navbar-target="menu" class="hidden md:hidden bg-white border-t border-stone-100">
    <div class="px-4 py-3 space-y-1">
      <%= mobile_nav_link "Videos", videos_path %>
      <%= mobile_nav_link "Blog", posts_path %>
      <%= mobile_nav_link "Courses", courses_path %>
      <%= mobile_nav_link "Books", books_path %>
      <%= mobile_nav_link "About", about_path %>
      <%= mobile_nav_link "Contact", contact_path %>
    </div>
  </div>
</header>
