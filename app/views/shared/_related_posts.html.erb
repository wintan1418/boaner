<% if posts.any? %>
  <div class="border-t border-gray-100 mt-12 pt-10">
    <h2 class="text-xl font-bold text-gray-900 mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">You might also like</h2>
    <div class="grid sm:grid-cols-2 gap-6">
      <% posts.each do |post| %>
        <%= render "posts/card", post: post %>
      <% end %>
    </div>
  </div>
<% end %>
