<%# SVG Logo: Quill pen with book motif + "Boaner" text
     Accepts `size` local: "sm" (navbar), "md" (default), "lg" (hero/splash)
%>
<% size ||= "md" %>
<% dimensions = { "sm" => 32, "md" => 44, "lg" => 64 }[size] %>
<% text_class = { "sm" => "text-[1.15rem]", "md" => "text-2xl", "lg" => "text-4xl" }[size] %>

<span class="inline-flex items-center gap-2">
  <svg width="<%= dimensions %>" height="<%= dimensions %>" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Boaner logo" role="img">
    <!-- Open book base -->
    <path d="M10 48 C10 44, 16 40, 32 42 C48 40, 54 44, 54 48 L54 50 C54 50, 48 47, 32 49 C16 47, 10 50, 10 50 Z"
          fill="#111827" opacity="0.85"/>
    <path d="M32 42 L32 49" stroke="#f59e0b" stroke-width="0.8" opacity="0.6"/>
    <!-- Book pages hint -->
    <path d="M12 47 C12 44.5, 17 41.5, 31 43" stroke="#374151" stroke-width="0.5" fill="none" opacity="0.4"/>
    <path d="M52 47 C52 44.5, 47 41.5, 33 43" stroke="#374151" stroke-width="0.5" fill="none" opacity="0.4"/>

    <!-- Quill feather — dominant element -->
    <!-- Main shaft -->
    <line x1="44" y1="8" x2="24" y2="44" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"/>

    <!-- Feather vanes — left side -->
    <path d="M44 8 C38 10, 34 16, 32 22 C34 18, 37 13, 43 9.5"
          fill="#f59e0b" opacity="0.85"/>
    <path d="M40 16 C35 19, 31 25, 29 30 C32 25, 35 21, 39 17.5"
          fill="#f59e0b" opacity="0.7"/>
    <path d="M36 24 C32 27, 29 32, 27 36 C30 32, 33 28, 35.5 25.5"
          fill="#f59e0b" opacity="0.55"/>

    <!-- Feather vanes — right side -->
    <path d="M44 8 C48 12, 48 18, 46 24 C47 18, 47 13, 44.5 9.5"
          fill="#d97706" opacity="0.8"/>
    <path d="M42 14 C45 18, 45.5 23, 44 28 C45 23, 44.5 19, 42.5 15.5"
          fill="#d97706" opacity="0.65"/>
    <path d="M39 22 C41 25, 42 29, 41 33 C42 29, 41.5 26, 39.5 23.5"
          fill="#d97706" opacity="0.5"/>

    <!-- Central quill rachis line -->
    <line x1="44" y1="9" x2="26" y2="40" stroke="#111827" stroke-width="0.6" opacity="0.3"/>

    <!-- Nib / pen tip -->
    <path d="M26 40 L24 44 L22.5 42.5 L26 40 Z" fill="#111827" opacity="0.9"/>
    <path d="M24 44 L23 46 L22.5 42.5" stroke="#111827" stroke-width="0.4" fill="none" opacity="0.6"/>

    <!-- Small ink dot at writing point -->
    <circle cx="23.5" cy="45.5" r="1" fill="#f59e0b" opacity="0.7"/>
  </svg>

  <span class="<%= text_class %> font-bold text-gray-900 tracking-tight" style="font-family: 'Source Serif 4', Georgia, serif;">Boaner</span>
</span>
