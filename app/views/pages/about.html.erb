<% content_for(:title) { "About — Boaner" } %>
<% content_for(:meta_description) { @settings.bio_short } %>

<!-- Hero Banner -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0">
    <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=1920&q=80&auto=format&fit=crop" alt="" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-gray-950/85"></div>
  </div>
  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 py-16 md:py-20">
    <h1 class="text-4xl md:text-5xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">About</h1>
    <p class="mt-3 text-gray-300 text-lg">The story behind the stories.</p>
    <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-4"></div>
  </div>
</section>

<!-- Profile + Bio Section -->
<section class="bg-white py-16 md:py-24">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="grid md:grid-cols-12 gap-10 md:gap-14">
      <!-- Photo -->
      <div class="md:col-span-4">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-br from-amber-500/20 to-orange-500/15 rounded-2xl blur-md"></div>
          <div class="relative aspect-[4/5] rounded-2xl overflow-hidden ring-2 ring-amber-500/30 shadow-xl">
            <%= render "shared/profile_image" %>
          </div>
        </div>

        <!-- Social links under photo -->
        <% if @settings.youtube_url.present? || @settings.twitter_url.present? || @settings.instagram_url.present? || @settings.linkedin_url.present? %>
          <div class="flex items-center gap-3 mt-6 justify-center">
            <% if @settings.youtube_url.present? %>
              <%= link_to @settings.youtube_url, target: "_blank", rel: "noopener", class: "w-10 h-10 rounded-lg bg-gray-100 hover:bg-red-500 flex items-center justify-center text-gray-400 hover:text-white transition-all", title: "YouTube" do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/></svg>
              <% end %>
            <% end %>
            <% if @settings.twitter_url.present? %>
              <%= link_to @settings.twitter_url, target: "_blank", rel: "noopener", class: "w-10 h-10 rounded-lg bg-gray-100 hover:bg-gray-900 flex items-center justify-center text-gray-400 hover:text-white transition-all", title: "X/Twitter" do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <% end %>
            <% end %>
            <% if @settings.instagram_url.present? %>
              <%= link_to @settings.instagram_url, target: "_blank", rel: "noopener", class: "w-10 h-10 rounded-lg bg-gray-100 hover:bg-pink-500 flex items-center justify-center text-gray-400 hover:text-white transition-all", title: "Instagram" do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C16.67.014 16.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              <% end %>
            <% end %>
            <% if @settings.linkedin_url.present? %>
              <%= link_to @settings.linkedin_url, target: "_blank", rel: "noopener", class: "w-10 h-10 rounded-lg bg-gray-100 hover:bg-blue-600 flex items-center justify-center text-gray-400 hover:text-white transition-all", title: "LinkedIn" do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Bio content — flows naturally, no overlap risk -->
      <div class="md:col-span-8">
        <p class="text-amber-600 font-semibold text-sm uppercase tracking-wider mb-3">Who I Am</p>
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 leading-tight" style="font-family: 'Source Serif 4', Georgia, serif;">
          <%= @settings.bio_short %>
        </h2>
        <div class="text-gray-600 leading-relaxed text-lg space-y-4">
          <p><%= @settings.bio_long %></p>
        </div>

        <!-- Quick stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-10 pt-8 border-t border-gray-100">
          <div class="text-center p-4 bg-gray-50 rounded-xl">
            <p class="text-2xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Video.count %>+</p>
            <p class="text-xs text-gray-500 font-medium mt-1">Videos</p>
          </div>
          <div class="text-center p-4 bg-gray-50 rounded-xl">
            <p class="text-2xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Post.count %>+</p>
            <p class="text-xs text-gray-500 font-medium mt-1">Articles</p>
          </div>
          <div class="text-center p-4 bg-gray-50 rounded-xl">
            <p class="text-2xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Course.published.count %></p>
            <p class="text-xs text-gray-500 font-medium mt-1">Courses</p>
          </div>
          <div class="text-center p-4 bg-gray-50 rounded-xl">
            <p class="text-2xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Book.count %></p>
            <p class="text-xs text-gray-500 font-medium mt-1">Books</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- What I Do Section -->
<section class="bg-gray-50 py-16 md:py-24">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="text-center mb-14">
      <p class="text-amber-600 font-semibold text-sm uppercase tracking-wider mb-3">What I Do</p>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;">Three passions. One mission.</h2>
      <p class="text-gray-500 mt-3 max-w-lg mx-auto">Sharing untold stories and forgotten histories through every medium available.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-white rounded-2xl p-8 border border-gray-100 hover:border-amber-200 hover:shadow-xl transition-all duration-300 card-hover text-center">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center mx-auto mb-6 shadow-lg shadow-red-500/20">
          <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3" style="font-family: 'Source Serif 4', Georgia, serif;">YouTube Creator</h3>
        <p class="text-gray-500 leading-relaxed">Producing documentary-style videos that bring forgotten chapters of history back to life for audiences around the world.</p>
        <%= link_to "Watch Videos &rarr;".html_safe, videos_path, class: "inline-block mt-5 text-sm font-semibold text-red-500 hover:text-red-600 transition-colors" %>
      </div>

      <div class="bg-white rounded-2xl p-8 border border-gray-100 hover:border-amber-200 hover:shadow-xl transition-all duration-300 card-hover text-center">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center mx-auto mb-6 shadow-lg shadow-blue-500/20">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3" style="font-family: 'Source Serif 4', Georgia, serif;">Lecturer</h3>
        <p class="text-gray-500 leading-relaxed">Teaching at university and creating structured online courses for anyone who believes learning never stops.</p>
        <%= link_to "Browse Courses &rarr;".html_safe, courses_path, class: "inline-block mt-5 text-sm font-semibold text-blue-500 hover:text-blue-600 transition-colors" %>
      </div>

      <div class="bg-white rounded-2xl p-8 border border-gray-100 hover:border-amber-200 hover:shadow-xl transition-all duration-300 card-hover text-center">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center mx-auto mb-6 shadow-lg shadow-amber-500/20">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3" style="font-family: 'Source Serif 4', Georgia, serif;">Writer</h3>
        <p class="text-gray-500 leading-relaxed">Published author exploring ideas, history, and the human experience through books, essays, and long-form storytelling.</p>
        <%= link_to "See Books &rarr;".html_safe, books_path, class: "inline-block mt-5 text-sm font-semibold text-amber-500 hover:text-amber-600 transition-colors" %>
      </div>
    </div>
  </div>
</section>

<!-- Featured Video Section -->
<% featured = Video.published.featured.first %>
<% if featured %>
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="text-center mb-10">
        <p class="text-amber-600 font-semibold text-sm uppercase tracking-wider mb-3">Featured Video</p>
        <h2 class="text-3xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;">Watch my latest work</h2>
      </div>

      <div data-controller="youtube" data-youtube-id-value="<%= featured.youtube_id %>" class="max-w-3xl mx-auto">
        <div class="relative aspect-video rounded-2xl overflow-hidden bg-gray-900 cursor-pointer group shadow-2xl" data-action="click->youtube#load">
          <img src="<%= featured.thumbnail_url %>" alt="<%= featured.title %>"
               class="w-full h-full object-cover"
               onerror="this.src='<%= featured.thumbnail_url_hq %>'">
          <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors flex items-center justify-center">
            <div class="w-20 h-20 bg-amber-500 rounded-full flex items-center justify-center shadow-lg shadow-amber-500/30 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
        <div data-youtube-target="player" class="hidden aspect-video rounded-2xl overflow-hidden"></div>
        <h3 class="text-lg font-bold text-gray-900 mt-4 text-center" style="font-family: 'Source Serif 4', Georgia, serif;"><%= featured.title %></h3>
      </div>
    </div>
  </section>
<% end %>

<!-- CTA -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0">
    <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=1920&q=80&auto=format&fit=crop" alt="" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-gradient-to-br from-amber-600/95 via-amber-500/90 to-orange-500/95"></div>
  </div>
  <div class="relative max-w-4xl mx-auto px-6 sm:px-8 lg:px-12 py-16 md:py-24 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">Let's Work Together</h2>
    <p class="mt-4 text-amber-100 text-lg max-w-md mx-auto">For speaking engagements, collaborations, or just to say hello.</p>
    <div class="flex flex-wrap gap-4 justify-center mt-8">
      <%= link_to "Get in Touch", contact_path, class: "px-8 py-4 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 transition-all shadow-lg text-sm" %>
      <%= link_to "Book a Lecture", contact_path, class: "px-8 py-4 bg-white/20 text-white font-semibold rounded-xl hover:bg-white/30 backdrop-blur-sm transition-all border border-white/30 text-sm" %>
    </div>
  </div>
</section>
