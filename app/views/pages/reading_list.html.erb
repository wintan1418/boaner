<% content_for(:title) { "Reading List — Boaner" } %>

<!-- Hero -->
<div class="bg-gray-900 text-white">
  <div class="max-w-4xl mx-auto px-6 sm:px-8 py-14 md:py-20 text-center">
    <h1 class="text-3xl md:text-4xl font-bold" style="font-family: 'Source Serif 4', Georgia, serif;">Reading List</h1>
    <p class="mt-3 text-gray-400 max-w-lg mx-auto">Your saved videos and articles, stored locally in your browser.</p>
  </div>
</div>

<!-- Content -->
<div class="max-w-2xl mx-auto px-6 sm:px-8 py-10 md:py-14" data-controller="reading-list">
  <!-- Empty State -->
  <div data-reading-list-target="empty" class="hidden text-center py-16">
    <svg class="w-16 h-16 text-gray-200 mx-auto mb-4" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z"/>
    </svg>
    <h2 class="text-lg font-semibold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;">No saved items yet</h2>
    <p class="mt-2 text-gray-400 text-sm">Browse videos and articles and click the bookmark icon to save them here.</p>
  </div>

  <!-- List -->
  <div data-reading-list-target="list" class="space-y-3"></div>
</div>
