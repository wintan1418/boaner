<% content_for(:title) { "Contact — Boaner" } %>

<section class="max-w-2xl mx-auto px-4 sm:px-6 py-12 md:py-16">
  <div class="mb-10">
    <h1 class="text-3xl font-bold text-stone-900" style="font-family: 'Source Serif 4', Georgia, serif;">Contact</h1>
    <p class="mt-1 text-stone-400">For speaking engagements, collaborations, or general inquiries.</p>
  </div>

  <div class="grid sm:grid-cols-3 gap-4 mb-10 text-sm">
    <div class="border border-stone-100 rounded-md p-4">
      <p class="font-medium text-stone-800 mb-1">Email</p>
      <p class="text-stone-400"><%= @settings.email %></p>
    </div>
    <div class="border border-stone-100 rounded-md p-4">
      <p class="font-medium text-stone-800 mb-1">Speaking</p>
      <p class="text-stone-400">Available for events</p>
    </div>
    <div class="border border-stone-100 rounded-md p-4">
      <p class="font-medium text-stone-800 mb-1">Response</p>
      <p class="text-stone-400">Within 48 hours</p>
    </div>
  </div>

  <%= turbo_frame_tag "contact_form" do %>
    <%= form_with url: contact_path, method: :post, class: "space-y-5", data: { controller: "form-validation" } do |f| %>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, "Name", class: "block text-sm font-medium text-stone-700 mb-1" %>
          <%= f.text_field :name, required: true, class: "w-full px-3 py-2.5 rounded-md border border-stone-200 text-sm focus:outline-none focus:ring-1 focus:ring-stone-400 focus:border-stone-400" %>
        </div>
        <div>
          <%= f.label :email, "Email", class: "block text-sm font-medium text-stone-700 mb-1" %>
          <%= f.email_field :email, required: true, class: "w-full px-3 py-2.5 rounded-md border border-stone-200 text-sm focus:outline-none focus:ring-1 focus:ring-stone-400 focus:border-stone-400" %>
        </div>
      </div>

      <div>
        <%= f.label :subject, "Subject", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.select :subject, ["Speaking Engagement", "Collaboration", "General Inquiry"], { prompt: "Select" }, class: "w-full px-3 py-2.5 rounded-md border border-stone-200 text-sm focus:outline-none focus:ring-1 focus:ring-stone-400 focus:border-stone-400 bg-white" %>
      </div>

      <div>
        <%= f.label :message, "Message", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.text_area :message, required: true, rows: 5, class: "w-full px-3 py-2.5 rounded-md border border-stone-200 text-sm focus:outline-none focus:ring-1 focus:ring-stone-400 focus:border-stone-400 resize-none" %>
      </div>

      <%= f.submit "Send Message", class: "px-5 py-2.5 bg-stone-900 text-white text-sm font-medium rounded-md hover:bg-stone-800 transition-colors cursor-pointer" %>
    <% end %>
  <% end %>
</section>
