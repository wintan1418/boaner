<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || meta_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= meta_description %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="<%= @settings&.site_name || 'Boaner' %> Blog" href="<%= feed_path(format: :rss) %>">

    <!-- Open Graph -->
    <meta property="og:title" content="<%= meta_title %>">
    <meta property="og:description" content="<%= meta_description %>">
    <meta property="og:image" content="<%= meta_image %>">
    <meta property="og:url" content="<%= meta_url %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= @settings&.site_name || 'Boaner' %>">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= meta_title %>">
    <meta name="twitter:description" content="<%= meta_description %>">
    <meta name="twitter:image" content="<%= meta_image %>">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-gray-50 text-gray-800 antialiased min-h-screen flex flex-col" style="font-family: 'Inter', system-ui, sans-serif;">
    <!-- Scroll progress -->
    <div data-controller="scroll-progress" class="scroll-progress"></div>

    <%= render "shared/navbar" %>

    <% if flash[:notice] || flash[:alert] %>
      <div data-controller="flash" class="fixed top-20 right-4 z-50 max-w-sm">
        <% if flash[:notice] %>
          <div data-flash-target="message" class="bg-amber-50 border border-amber-200 text-amber-900 px-5 py-3.5 rounded-xl shadow-lg text-sm font-medium flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <%= flash[:notice] %>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div data-flash-target="message" class="bg-red-50 border border-red-200 text-red-800 px-5 py-3.5 rounded-xl shadow-lg text-sm font-medium flex items-center gap-2">
            <svg class="w-5 h-5 text-red-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
            <%= flash[:alert] %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>

    <!-- Birthday reveal (plays 3 times then never again) -->
    <%= render "shared/birthday_reveal" %>
  </body>
</html>
