<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Boaner" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "YouTuber. Lecturer. Writer." %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-white text-stone-800 antialiased min-h-screen flex flex-col">
    <%= render "shared/navbar" %>

    <% if flash[:notice] || flash[:alert] %>
      <div data-controller="flash" class="fixed top-20 right-4 z-50 max-w-sm">
        <% if flash[:notice] %>
          <div data-flash-target="message" class="bg-white border border-stone-200 text-stone-800 px-4 py-3 rounded-md shadow-md text-sm">
            <%= flash[:notice] %>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div data-flash-target="message" class="bg-white border border-red-200 text-red-700 px-4 py-3 rounded-md shadow-md text-sm">
            <%= flash[:alert] %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
