<%= form_with(model: [:admin, course], class: "space-y-6") do |f| %>
  <% if course.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex items-center mb-2">
        <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <h3 class="text-sm font-semibold text-red-800"><%= pluralize(course.errors.count, "error") %> prevented this course from being saved:</h3>
      </div>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6">
    <div>
      <label for="course_title" class="block text-sm font-semibold text-gray-700 mb-1.5">Title</label>
      <%= f.text_field :title, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "Enter course title" %>
    </div>

    <div>
      <label for="course_slug" class="block text-sm font-semibold text-gray-700 mb-1.5">Slug</label>
      <%= f.text_field :slug, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "auto-generated-from-title" %>
      <p class="text-xs text-gray-400 mt-1">Leave blank to auto-generate from title.</p>
    </div>

    <div>
      <label for="course_description" class="block text-sm font-semibold text-gray-700 mb-1.5">Description</label>
      <%= f.text_area :description, rows: 4, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition resize-y", placeholder: "Describe what students will learn" %>
    </div>

    <div class="flex items-center">
      <%= f.check_box :published, class: "w-4 h-4 text-amber-500 border-gray-300 rounded focus:ring-amber-500" %>
      <label for="course_published" class="ml-2 text-sm font-medium text-gray-700">Published</label>
      <p class="ml-2 text-xs text-gray-400">(visible to the public)</p>
    </div>
  </div>

  <!-- Lessons section (only on edit) -->
  <% if course.persisted? %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-900">Lessons</h2>
        <a href="<%= new_admin_course_lesson_path(course) %>" class="inline-flex items-center px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold rounded-lg transition-colors">
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          Add Lesson
        </a>
      </div>
      <div class="divide-y divide-gray-100">
        <% course.lessons.order(position: :asc).each do |lesson| %>
          <div class="px-6 py-3 flex items-center justify-between hover:bg-gray-50 transition-colors">
            <div class="flex items-center">
              <span class="w-7 h-7 bg-gray-100 rounded-full flex items-center justify-center text-xs font-semibold text-gray-500 mr-3"><%= lesson.position || "-" %></span>
              <div>
                <p class="text-sm font-medium text-gray-900"><%= lesson.title %></p>
                <% if lesson.free_preview? %>
                  <span class="text-xs text-emerald-600 font-medium">Free preview</span>
                <% end %>
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <a href="<%= edit_admin_course_lesson_path(course, lesson) %>" class="text-gray-400 hover:text-amber-600 transition-colors p-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
              </a>
              <%= button_to admin_course_lesson_path(course, lesson), method: :delete, data: { turbo_confirm: "Delete this lesson?" }, class: "text-gray-400 hover:text-red-500 transition-colors p-1" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if course.lessons.empty? %>
          <div class="px-6 py-8 text-center text-gray-400 text-sm">No lessons yet. Add your first lesson above.</div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="flex items-center justify-between pt-2">
    <a href="<%= admin_courses_path %>" class="text-sm text-gray-500 hover:text-gray-700 font-medium">Cancel</a>
    <%= f.submit class: "inline-flex items-center px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm cursor-pointer" %>
  </div>
<% end %>
