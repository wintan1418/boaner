<%= form_with(model: [:admin, @course, lesson], class: "space-y-6") do |f| %>
  <% if lesson.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex items-center mb-2">
        <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <h3 class="text-sm font-semibold text-red-800"><%= pluralize(lesson.errors.count, "error") %> prevented this lesson from being saved:</h3>
      </div>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% lesson.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6">
    <div>
      <label for="lesson_title" class="block text-sm font-semibold text-gray-700 mb-1.5">Title</label>
      <%= f.text_field :title, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "Enter lesson title" %>
    </div>

    <div>
      <label for="lesson_body" class="block text-sm font-semibold text-gray-700 mb-1.5">Body</label>
      <%= f.rich_text_area :body, class: "w-full min-h-[300px]" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="lesson_position" class="block text-sm font-semibold text-gray-700 mb-1.5">Position</label>
        <%= f.number_field :position, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "1", min: 0 %>
        <p class="text-xs text-gray-400 mt-1">Order in which this lesson appears.</p>
      </div>
      <div class="flex items-end pb-2">
        <div class="flex items-center">
          <%= f.check_box :free_preview, class: "w-4 h-4 text-amber-500 border-gray-300 rounded focus:ring-amber-500" %>
          <label for="lesson_free_preview" class="ml-2 text-sm font-medium text-gray-700">Free preview</label>
          <p class="ml-2 text-xs text-gray-400">(available without enrollment)</p>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <a href="<%= edit_admin_course_path(@course) %>" class="text-sm text-gray-500 hover:text-gray-700 font-medium">Cancel</a>
    <%= f.submit class: "inline-flex items-center px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm cursor-pointer" %>
  </div>
<% end %>
