<% content_for(:title, "Edit Lesson — Boaner Admin") %>

<div class="mb-8">
  <a href="<%= edit_admin_course_path(@course) %>" class="text-sm text-gray-500 hover:text-amber-600 font-medium inline-flex items-center mb-2">
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    Back to <%= @course.title %>
  </a>
  <h1 class="text-2xl font-bold text-gray-900">Edit Lesson</h1>
  <p class="text-gray-500 text-sm mt-1">Course: <strong><%= @course.title %></strong></p>
</div>

<div class="max-w-3xl">
  <%= render "form", lesson: @lesson %>
</div>
