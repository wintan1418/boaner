<aside class="fixed inset-y-0 left-0 w-64 bg-gray-900 flex flex-col z-30">
  <!-- Logo -->
  <div class="px-6 py-5 border-b border-gray-800">
    <a href="<%= admin_path %>" class="text-white text-xl font-bold tracking-tight">
      Boaner
      <span class="block text-xs font-normal text-gray-400 mt-0.5">Admin Panel</span>
    </a>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <%
      nav_items = [
        { label: "Dashboard", path: admin_path, icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6", match: admin_path },
        { label: "Videos", path: admin_videos_path, icon: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664zM21 12a9 9 0 11-18 0 9 9 0 0118 0z", match: "videos" },
        { label: "Series", path: admin_series_index_path, icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10", match: "series" },
        { label: "Blog Posts", path: admin_posts_path, icon: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z", match: "posts" },
        { label: "Courses", path: admin_courses_path, icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253", match: "courses" },
        { label: "Books", path: admin_books_path, icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253", match: "books" },
        { label: "Messages", path: admin_contact_messages_path, icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z", match: "contact_messages", badge: ContactMessage.unread.count },
        { label: "Newsletters", path: admin_newsletters_path, icon: "M12 19l9 2-9-18-9 18 9-2zm0 0v-8", match: "newsletters" },
        { label: "Comments", path: admin_comments_path, icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z", match: "comments" },
        { label: "Subscribers", path: admin_subscribers_path, icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z", match: "subscribers" },
        { label: "Settings", path: edit_admin_settings_path, icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z", match: "settings" },
      ]
    %>
    <% nav_items.each do |item| %>
      <%
        is_active = if item[:match] == admin_path
          request.path == admin_path
        else
          request.path.include?(item[:match])
        end
      %>
      <a href="<%= item[:path] %>"
         class="flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors
                <%= is_active ? 'bg-gray-800 text-white border-l-2 border-amber-500' : 'text-gray-300 hover:bg-gray-800 hover:text-white border-l-2 border-transparent' %>">
        <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= item[:icon] %>" />
        </svg>
        <span class="flex-1"><%= item[:label] %></span>
        <% if item[:badge].present? && item[:badge] > 0 %>
          <span class="ml-auto px-2 py-0.5 text-xs font-bold bg-amber-500 text-white rounded-full"><%= item[:badge] %></span>
        <% end %>
      </a>
    <% end %>
  </nav>

  <!-- Admin user + Logout -->
  <div class="px-3 py-4 border-t border-gray-800">
    <div class="flex items-center px-3 py-2 mb-2">
      <div class="w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center text-white text-sm font-bold mr-3">
        <%= current_admin&.email&.first&.upcase || "A" %>
      </div>
      <div class="truncate">
        <p class="text-sm font-medium text-white truncate"><%= current_admin&.email %></p>
      </div>
    </div>
    <%= button_to "Sign Out", admin_logout_path, method: :delete, class: "w-full flex items-center px-3 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800 rounded-lg transition-colors" %>
  </div>
</aside>
