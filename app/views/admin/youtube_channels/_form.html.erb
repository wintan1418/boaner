<%= form_with(model: [:admin, channel], class: "space-y-6") do |f| %>
  <% if channel.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex items-center mb-2">
        <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <h3 class="text-sm font-semibold text-red-800"><%= pluralize(channel.errors.count, "error") %> prevented this channel from being saved:</h3>
      </div>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% channel.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6">
    <div>
      <label for="youtube_channel_name" class="block text-sm font-semibold text-gray-700 mb-1.5">Name</label>
      <%= f.text_field :name, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "e.g. HistovraLive" %>
    </div>

    <div>
      <label for="youtube_channel_channel_id" class="block text-sm font-semibold text-gray-700 mb-1.5">Channel ID</label>
      <%= f.text_field :channel_id, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "UCxxxxxxxxxxxxxxxxxxxxxxxx" %>
      <p class="text-xs text-gray-400 mt-1">The UC... ID from YouTube. Find it at youtube.com/account_advanced or in your channel URL.</p>
    </div>

    <div>
      <label for="youtube_channel_api_key" class="block text-sm font-semibold text-gray-700 mb-1.5">API Key</label>
      <%= f.text_field :api_key, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "AIzaSy..." %>
      <p class="text-xs text-gray-400 mt-1">Get a free API key from <a href="https://console.cloud.google.com/apis/credentials" target="_blank" class="text-amber-600 hover:underline">Google Cloud Console</a>. Enable the YouTube Data API v3.</p>
    </div>

    <div class="flex items-center gap-3">
      <%= f.check_box :auto_sync, class: "w-4 h-4 rounded border-gray-300 text-amber-500 focus:ring-amber-500" %>
      <%= f.label :auto_sync, "Enable automatic sync", class: "text-sm text-gray-700" %>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <a href="<%= admin_youtube_channels_path %>" class="text-sm text-gray-500 hover:text-gray-700 font-medium">Cancel</a>
    <div class="flex items-center space-x-3">
      <%= f.submit class: "inline-flex items-center px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm cursor-pointer" %>
    </div>
  </div>
<% end %>
