<%= form_with(model: [:admin, series], class: "space-y-6") do |f| %>
  <% if series.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex items-center mb-2">
        <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <h3 class="text-sm font-semibold text-red-800"><%= pluralize(series.errors.count, "error") %> prevented this series from being saved:</h3>
      </div>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% series.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6">
    <div>
      <label for="series_title" class="block text-sm font-semibold text-gray-700 mb-1.5">Title</label>
      <%= f.text_field :title, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "Enter series title" %>
    </div>

    <div>
      <label for="series_slug" class="block text-sm font-semibold text-gray-700 mb-1.5">Slug</label>
      <%= f.text_field :slug, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "auto-generated-from-title" %>
      <p class="text-xs text-gray-400 mt-1">Leave blank to auto-generate from title.</p>
    </div>

    <div>
      <label for="series_description" class="block text-sm font-semibold text-gray-700 mb-1.5">Description</label>
      <%= f.text_area :description, rows: 4, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition resize-y", placeholder: "Brief description of the series" %>
    </div>

    <div>
      <label for="series_position" class="block text-sm font-semibold text-gray-700 mb-1.5">Position</label>
      <%= f.number_field :position, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "Display order (lower = first)" %>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <a href="<%= admin_series_index_path %>" class="text-sm text-gray-500 hover:text-gray-700 font-medium">Cancel</a>
    <div class="flex items-center space-x-3">
      <%= f.submit class: "inline-flex items-center px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm cursor-pointer" %>
    </div>
  </div>
<% end %>
