<%= form_with(model: [:admin, book], class: "space-y-6", multipart: true) do |f| %>
  <% if book.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex items-center mb-2">
        <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <h3 class="text-sm font-semibold text-red-800"><%= pluralize(book.errors.count, "error") %> prevented this book from being saved:</h3>
      </div>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6">
    <div>
      <label for="book_title" class="block text-sm font-semibold text-gray-700 mb-1.5">Title</label>
      <%= f.text_field :title, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "Enter book title" %>
    </div>

    <div>
      <label for="book_description" class="block text-sm font-semibold text-gray-700 mb-1.5">Description</label>
      <%= f.text_area :description, rows: 4, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition resize-y", placeholder: "Brief description of the book" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="book_buy_url" class="block text-sm font-semibold text-gray-700 mb-1.5">Buy URL</label>
        <%= f.url_field :buy_url, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "https://amazon.com/..." %>
      </div>
      <div>
        <label for="book_published_year" class="block text-sm font-semibold text-gray-700 mb-1.5">Published Year</label>
        <%= f.number_field :published_year, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "2024", min: 1900, max: 2100 %>
      </div>
    </div>

    <div>
      <label for="book_cover" class="block text-sm font-semibold text-gray-700 mb-1.5">Cover Image</label>
      <% if book.cover.attached? %>
        <div class="mb-3">
          <%= image_tag book.cover, class: "w-24 h-auto rounded-lg border border-gray-200" %>
        </div>
      <% end %>
      <%= f.file_field :cover, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100 cursor-pointer" %>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <a href="<%= admin_books_path %>" class="text-sm text-gray-500 hover:text-gray-700 font-medium">Cancel</a>
    <%= f.submit class: "inline-flex items-center px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm cursor-pointer" %>
  </div>
<% end %>
