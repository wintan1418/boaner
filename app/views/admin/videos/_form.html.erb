<%= form_with(model: [:admin, video], class: "space-y-6") do |f| %>
  <% if video.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex items-center mb-2">
        <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <h3 class="text-sm font-semibold text-red-800"><%= pluralize(video.errors.count, "error") %> prevented this video from being saved:</h3>
      </div>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% video.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6">
    <div>
      <label for="video_title" class="block text-sm font-semibold text-gray-700 mb-1.5">Title</label>
      <%= f.text_field :title, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "Enter video title" %>
    </div>

    <div>
      <label for="video_youtube_id" class="block text-sm font-semibold text-gray-700 mb-1.5">YouTube ID</label>
      <%= f.text_field :youtube_id, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "e.g. dQw4w9WgXcQ" %>
      <p class="text-xs text-gray-400 mt-1">The ID from the YouTube URL (youtube.com/watch?v=<strong>THIS_PART</strong>)</p>
      <% if video.youtube_id.present? %>
        <div class="mt-3">
          <img src="<%= video.thumbnail_url_hq %>" class="w-48 h-auto rounded-lg border border-gray-200" alt="Thumbnail preview">
        </div>
      <% end %>
    </div>

    <div>
      <label for="video_description" class="block text-sm font-semibold text-gray-700 mb-1.5">Description</label>
      <%= f.text_area :description, rows: 4, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition resize-y", placeholder: "Brief description of the video" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="video_category" class="block text-sm font-semibold text-gray-700 mb-1.5">Category</label>
        <%= f.text_field :category, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "e.g. Tutorial, Vlog, Lecture" %>
      </div>
      <div>
        <label for="video_published_at" class="block text-sm font-semibold text-gray-700 mb-1.5">Published Date</label>
        <%= f.date_field :published_at, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition" %>
      </div>
    </div>

    <div class="flex items-center">
      <%= f.check_box :featured, class: "w-4 h-4 text-amber-500 border-gray-300 rounded focus:ring-amber-500" %>
      <label for="video_featured" class="ml-2 text-sm font-medium text-gray-700">Featured video</label>
      <p class="ml-2 text-xs text-gray-400">(will be highlighted on the homepage)</p>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <a href="<%= admin_videos_path %>" class="text-sm text-gray-500 hover:text-gray-700 font-medium">Cancel</a>
    <div class="flex items-center space-x-3">
      <%= f.submit class: "inline-flex items-center px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm cursor-pointer" %>
    </div>
  </div>
<% end %>
