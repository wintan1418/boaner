<%= form_with(model: [:admin, newsletter], class: "space-y-6 max-w-3xl") do |f| %>
  <% if newsletter.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <ul class="list-disc list-inside text-sm text-red-700">
        <% newsletter.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-1">Compose Newsletter</h2>
    <p class="text-sm text-gray-500 mb-6">Will be sent to <strong><%= Subscriber.count %></strong> subscribers.</p>

    <div class="space-y-5">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Subject Line</label>
        <%= f.text_field :subject, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent", placeholder: "e.g. New video: The Black Pharaohs of Egypt" %>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Content</label>
        <div data-controller="rich-editor">
          <%= f.rich_text_area :body, class: "w-full" %>
        </div>
        <p class="text-xs text-gray-400 mt-1">Use the toolbar to format text — headings, alignment, lists, links, and more.</p>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "Save Draft", class: "px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", admin_newsletters_path, class: "px-6 py-2.5 text-gray-500 hover:text-gray-700 text-sm font-medium transition-colors" %>
  </div>
<% end %>
