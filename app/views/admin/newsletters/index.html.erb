<% content_for(:title, "Newsletters — Boaner Admin") %>

<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Newsletters</h1>
    <p class="text-gray-500 text-sm mt-1"><%= Subscriber.count %> subscribers</p>
  </div>
  <%= link_to new_admin_newsletter_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-lg transition-colors" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Compose
  <% end %>
</div>

<% if @newsletters.any? %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Subject</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Recipients</th>
          <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
          <th class="text-right px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @newsletters.each do |newsletter| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4">
              <span class="text-sm font-semibold text-gray-900"><%= newsletter.subject %></span>
            </td>
            <td class="px-6 py-4">
              <% if newsletter.sent? %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  Sent
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                  Draft
                </span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= newsletter.recipients_count || "—" %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= newsletter.sent_at&.strftime("%b %d, %Y") || newsletter.created_at.strftime("%b %d, %Y") %></td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <% if newsletter.draft? %>
                  <%= link_to edit_admin_newsletter_path(newsletter), class: "p-1.5 text-gray-400 hover:text-amber-600 transition-colors", title: "Edit" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  <% end %>
                  <%= button_to send_newsletter_admin_newsletter_path(newsletter), method: :post, class: "inline-flex items-center gap-1 px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold rounded-lg transition-colors", data: { turbo_confirm: "Send this newsletter to #{Subscriber.count} subscribers?" } do %>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                    Send
                  <% end %>
                <% end %>
                <%= button_to admin_newsletter_path(newsletter), method: :delete, class: "p-1.5 text-gray-400 hover:text-red-500 transition-colors", data: { turbo_confirm: "Delete this newsletter?" }, title: "Delete" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-16 bg-white rounded-xl border border-gray-200">
    <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
    <p class="text-gray-400 font-medium mb-4">No newsletters yet.</p>
    <%= link_to "Compose your first newsletter", new_admin_newsletter_path, class: "text-amber-600 hover:text-amber-700 text-sm font-semibold" %>
  </div>
<% end %>
