<% content_for(:title, "Subscribers — Boaner Admin") %>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900">Subscribers</h1>
  <p class="text-gray-500 text-sm mt-1">Your email subscriber list (<%= @subscribers.count %> total).</p>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="w-full">
    <thead>
      <tr class="bg-gray-50 border-b border-gray-200">
        <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</th>
        <th class="text-left px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Subscribed</th>
        <th class="text-right px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @subscribers.each_with_index do |subscriber, i| %>
        <tr class="<%= i.odd? ? 'bg-gray-50/50' : '' %> hover:bg-gray-50 transition-colors">
          <td class="px-6 py-4">
            <div class="flex items-center">
              <div class="w-8 h-8 rounded-full bg-violet-100 flex items-center justify-center text-violet-600 text-xs font-bold mr-3 flex-shrink-0">
                <%= subscriber.email.first.upcase %>
              </div>
              <p class="text-sm font-medium text-gray-900"><%= subscriber.email %></p>
            </div>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500">
            <%= (subscriber.subscribed_at || subscriber.created_at).strftime("%b %d, %Y") %>
          </td>
          <td class="px-6 py-4 text-right">
            <%= button_to admin_subscriber_path(subscriber), method: :delete, data: { turbo_confirm: "Remove this subscriber?" }, class: "inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg bg-red-100 text-red-700 hover:bg-red-200 transition-colors" do %>
              Remove
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @subscribers.empty? %>
    <div class="px-6 py-16 text-center">
      <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      <p class="text-gray-500 text-sm">No subscribers yet.</p>
    </div>
  <% end %>
</div>
