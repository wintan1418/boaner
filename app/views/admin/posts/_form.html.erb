<%= form_with(model: [:admin, post], class: "space-y-6") do |f| %>
  <% if post.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex items-center mb-2">
        <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <h3 class="text-sm font-semibold text-red-800"><%= pluralize(post.errors.count, "error") %> prevented this post from being saved:</h3>
      </div>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6">
    <div>
      <label for="post_title" class="block text-sm font-semibold text-gray-700 mb-1.5">Title</label>
      <%= f.text_field :title, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "Enter post title" %>
    </div>

    <div>
      <label for="post_slug" class="block text-sm font-semibold text-gray-700 mb-1.5">Slug</label>
      <%= f.text_field :slug, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "auto-generated-from-title" %>
      <p class="text-xs text-gray-400 mt-1">Leave blank to auto-generate from title. Used in the URL: /blog/<strong>your-slug</strong></p>
    </div>

    <div>
      <label for="post_excerpt" class="block text-sm font-semibold text-gray-700 mb-1.5">Excerpt</label>
      <%= f.text_area :excerpt, rows: 3, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition resize-y", placeholder: "Brief summary shown in post listings" %>
    </div>

    <div>
      <label for="post_body" class="block text-sm font-semibold text-gray-700 mb-1.5">Body</label>
      <div data-controller="rich-editor">
        <%= f.rich_text_area :body, class: "w-full min-h-[300px]" %>
      </div>
      <p class="text-xs text-gray-400 mt-1">Use the toolbar to format text — headings, alignment, lists, links, and more.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="post_category" class="block text-sm font-semibold text-gray-700 mb-1.5">Category</label>
        <%= f.text_field :category, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "e.g. Writing, Teaching, Tech" %>
      </div>
      <div>
        <label for="post_published_at" class="block text-sm font-semibold text-gray-700 mb-1.5">Published Date</label>
        <%= f.date_field :published_at, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition" %>
      </div>
    </div>

    <div class="flex items-center">
      <%= f.check_box :featured, class: "w-4 h-4 text-amber-500 border-gray-300 rounded focus:ring-amber-500" %>
      <label for="post_featured" class="ml-2 text-sm font-medium text-gray-700">Featured post</label>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <a href="<%= admin_posts_path %>" class="text-sm text-gray-500 hover:text-gray-700 font-medium">Cancel</a>
    <%= f.submit class: "inline-flex items-center px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm cursor-pointer" %>
  </div>
<% end %>
