<% content_for(:title, "Settings — Boaner Admin") %>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900">Site Settings</h1>
  <p class="text-gray-500 text-sm mt-1">Configure your site branding, content, and social links.</p>
</div>

<div class="max-w-3xl">
  <%= form_with(model: @settings, url: admin_settings_path, method: :patch, class: "space-y-8", multipart: true) do |f| %>
    <% if @settings.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <div class="flex items-center mb-2">
          <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <h3 class="text-sm font-semibold text-red-800">Please fix the following errors:</h3>
        </div>
        <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
          <% @settings.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Branding -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">Branding</h2>
      <p class="text-sm text-gray-500 mb-6">Your site name, tagline, and profile image.</p>

      <div class="space-y-6">
        <div>
          <label for="site_setting_site_name" class="block text-sm font-semibold text-gray-700 mb-1.5">Site Name</label>
          <%= f.text_field :site_name, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition" %>
        </div>
        <div>
          <label for="site_setting_tagline" class="block text-sm font-semibold text-gray-700 mb-1.5">Tagline</label>
          <%= f.text_field :tagline, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition" %>
        </div>
        <div>
          <label for="site_setting_profile_image" class="block text-sm font-semibold text-gray-700 mb-1.5">Profile Image</label>
          <% if @settings.profile_image.attached? %>
            <div class="mb-3">
              <%= image_tag @settings.profile_image, class: "w-20 h-20 rounded-full object-cover border-2 border-gray-200" %>
            </div>
          <% end %>
          <%= f.file_field :profile_image, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100 cursor-pointer" %>
        </div>
      </div>
    </div>

    <!-- Hero Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">Hero Section</h2>
      <p class="text-sm text-gray-500 mb-6">The main heading and background on your homepage.</p>

      <div class="space-y-6">
        <div>
          <label for="site_setting_hero_heading" class="block text-sm font-semibold text-gray-700 mb-1.5">Heading</label>
          <%= f.text_field :hero_heading, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition" %>
        </div>
        <div>
          <label for="site_setting_hero_subheading" class="block text-sm font-semibold text-gray-700 mb-1.5">Subheading</label>
          <%= f.text_area :hero_subheading, rows: 2, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition resize-y" %>
        </div>
        <div>
          <label for="site_setting_hero_background" class="block text-sm font-semibold text-gray-700 mb-1.5">Background Image</label>
          <% if @settings.hero_background.attached? %>
            <div class="mb-3">
              <%= image_tag @settings.hero_background, class: "w-full max-w-sm h-32 object-cover rounded-lg border border-gray-200" %>
            </div>
          <% end %>
          <%= f.file_field :hero_background, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100 cursor-pointer" %>
        </div>
      </div>
    </div>

    <!-- Bio -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">Bio</h2>
      <p class="text-sm text-gray-500 mb-6">Your short and long bio text.</p>

      <div class="space-y-6">
        <div>
          <label for="site_setting_bio_short" class="block text-sm font-semibold text-gray-700 mb-1.5">Short Bio</label>
          <%= f.text_area :bio_short, rows: 2, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition resize-y" %>
          <p class="text-xs text-gray-400 mt-1">Used in cards and previews.</p>
        </div>
        <div>
          <label for="site_setting_bio_long" class="block text-sm font-semibold text-gray-700 mb-1.5">Long Bio</label>
          <%= f.text_area :bio_long, rows: 5, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition resize-y" %>
          <p class="text-xs text-gray-400 mt-1">Used on the About page.</p>
        </div>
      </div>
    </div>

    <!-- Social Links -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">Social Links</h2>
      <p class="text-sm text-gray-500 mb-6">Links to your social media profiles.</p>

      <div class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="site_setting_youtube_url" class="block text-sm font-semibold text-gray-700 mb-1.5">YouTube</label>
            <%= f.url_field :youtube_url, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "https://youtube.com/@channel" %>
          </div>
          <div>
            <label for="site_setting_twitter_url" class="block text-sm font-semibold text-gray-700 mb-1.5">Twitter / X</label>
            <%= f.url_field :twitter_url, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "https://twitter.com/handle" %>
          </div>
          <div>
            <label for="site_setting_instagram_url" class="block text-sm font-semibold text-gray-700 mb-1.5">Instagram</label>
            <%= f.url_field :instagram_url, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "https://instagram.com/handle" %>
          </div>
          <div>
            <label for="site_setting_linkedin_url" class="block text-sm font-semibold text-gray-700 mb-1.5">LinkedIn</label>
            <%= f.url_field :linkedin_url, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "https://linkedin.com/in/profile" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">Contact</h2>
      <p class="text-sm text-gray-500 mb-6">Your contact email address.</p>

      <div>
        <label for="site_setting_email" class="block text-sm font-semibold text-gray-700 mb-1.5">Email</label>
        <%= f.email_field :email, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "hello@boaner.com" %>
      </div>
    </div>

    <!-- YouTube Auto-Sync -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">YouTube Auto-Sync</h2>
      <p class="text-sm text-gray-500 mb-6">Connect your YouTube channel to automatically import new videos. Runs every 6 hours.</p>

      <div class="space-y-6">
        <div>
          <label for="site_setting_youtube_channel_id" class="block text-sm font-semibold text-gray-700 mb-1.5">Channel ID</label>
          <%= f.text_field :youtube_channel_id, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "UCxxxxxxxxxxxxxxxxxxxxxxxx" %>
          <p class="text-xs text-gray-400 mt-1">Find it at youtube.com/account_advanced or in your channel URL.</p>
        </div>
        <div>
          <label for="site_setting_youtube_api_key" class="block text-sm font-semibold text-gray-700 mb-1.5">YouTube API Key</label>
          <%= f.text_field :youtube_api_key, class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition", placeholder: "AIzaSy..." %>
          <p class="text-xs text-gray-400 mt-1">Get a free API key from <a href="https://console.cloud.google.com/apis/credentials" target="_blank" class="text-amber-600 hover:underline">Google Cloud Console</a>. Enable the YouTube Data API v3.</p>
        </div>
        <div class="flex items-center gap-3">
          <%= f.check_box :youtube_auto_sync, class: "w-4 h-4 rounded border-gray-300 text-amber-500 focus:ring-amber-500" %>
          <%= f.label :youtube_auto_sync, "Enable automatic sync (every 6 hours)", class: "text-sm text-gray-700" %>
        </div>
      </div>

      <% if @settings.youtube_channel_id.present? && @settings.youtube_api_key.present? %>
        <div class="border-t border-gray-100 pt-4 mt-2">
          <%= button_to "Sync Now", sync_youtube_admin_settings_path, method: :post, class: "inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white text-sm font-semibold rounded-lg hover:bg-gray-800 transition-colors cursor-pointer" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Sync YouTube Now
          <% end %>
          <p class="text-xs text-gray-400 mt-2">Fetches latest videos from your channel immediately.</p>
        </div>
      <% end %>
    </div>

    <!-- Submit -->
    <div class="flex items-center justify-end pt-2">
      <%= f.submit "Save Settings", class: "inline-flex items-center px-6 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
