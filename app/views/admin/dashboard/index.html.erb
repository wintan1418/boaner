<% content_for(:title, "Dashboard — Boaner Admin") %>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
  <p class="text-gray-500 text-sm mt-1">Welcome back. Here's what's happening with your site.</p>
</div>

<!-- Stat Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 border-l-4 border-l-amber-500">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">Videos</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @video_count %></p>
      </div>
      <div class="w-12 h-12 bg-amber-50 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664zM21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 border-l-4 border-l-emerald-500">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">Blog Posts</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @post_count %></p>
      </div>
      <div class="w-12 h-12 bg-emerald-50 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 border-l-4 border-l-blue-500">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">Courses</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @course_count %></p>
      </div>
      <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 border-l-4 border-l-violet-500">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">Subscribers</p>
        <p class="text-3xl font-bold text-gray-900 mt-1"><%= @subscriber_count %></p>
      </div>
      <div class="w-12 h-12 bg-violet-50 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- Pending Comments Alert -->
<% if @pending_comments_count > 0 %>
  <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-8 flex items-center justify-between">
    <div class="flex items-center">
      <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center mr-3">
        <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-amber-800"><%= @pending_comments_count %> pending comment<%= @pending_comments_count == 1 ? '' : 's' %></p>
        <p class="text-xs text-amber-600">Review and approve or reject pending comments.</p>
      </div>
    </div>
    <a href="<%= admin_comments_path %>" class="text-sm font-medium text-amber-700 hover:text-amber-900 bg-amber-100 hover:bg-amber-200 px-4 py-2 rounded-lg transition-colors">
      Review
    </a>
  </div>
<% end %>

<!-- Recent Activity -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Recent Videos -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-900">Recent Videos</h2>
      <a href="<%= admin_videos_path %>" class="text-sm text-amber-600 hover:text-amber-700 font-medium">View all</a>
    </div>
    <div class="divide-y divide-gray-100">
      <% @recent_videos.each do |video| %>
        <div class="px-6 py-3 flex items-center justify-between hover:bg-gray-50 transition-colors">
          <div class="flex items-center min-w-0">
            <img src="<%= video.thumbnail_url_hq %>" class="w-16 h-9 object-cover rounded mr-3 flex-shrink-0" alt="" loading="lazy">
            <div class="min-w-0">
              <p class="text-sm font-medium text-gray-900 truncate"><%= video.title %></p>
              <p class="text-xs text-gray-500"><%= video.created_at.strftime("%b %d, %Y") %></p>
            </div>
          </div>
          <a href="<%= edit_admin_video_path(video) %>" class="text-sm text-gray-400 hover:text-amber-600 ml-2 flex-shrink-0">Edit</a>
        </div>
      <% end %>
      <% if @recent_videos.empty? %>
        <div class="px-6 py-8 text-center text-gray-400 text-sm">No videos yet.</div>
      <% end %>
    </div>
  </div>

  <!-- Recent Posts -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-900">Recent Posts</h2>
      <a href="<%= admin_posts_path %>" class="text-sm text-amber-600 hover:text-amber-700 font-medium">View all</a>
    </div>
    <div class="divide-y divide-gray-100">
      <% @recent_posts.each do |post| %>
        <div class="px-6 py-3 flex items-center justify-between hover:bg-gray-50 transition-colors">
          <div class="min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate"><%= post.title %></p>
            <p class="text-xs text-gray-500"><%= post.created_at.strftime("%b %d, %Y") %></p>
          </div>
          <a href="<%= edit_admin_post_path(post) %>" class="text-sm text-gray-400 hover:text-amber-600 ml-2 flex-shrink-0">Edit</a>
        </div>
      <% end %>
      <% if @recent_posts.empty? %>
        <div class="px-6 py-8 text-center text-gray-400 text-sm">No posts yet.</div>
      <% end %>
    </div>
  </div>

  <!-- Recent Comments -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-900">Recent Comments</h2>
      <a href="<%= admin_comments_path %>" class="text-sm text-amber-600 hover:text-amber-700 font-medium">View all</a>
    </div>
    <div class="divide-y divide-gray-100">
      <% @recent_comments.each do |comment| %>
        <div class="px-6 py-3 hover:bg-gray-50 transition-colors">
          <div class="flex items-center justify-between mb-1">
            <p class="text-sm font-medium text-gray-900"><%= comment.name %></p>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= comment.approved? ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>">
              <%= comment.approved? ? 'Approved' : 'Pending' %>
            </span>
          </div>
          <p class="text-xs text-gray-500 truncate"><%= truncate(comment.body, length: 80) %></p>
        </div>
      <% end %>
      <% if @recent_comments.empty? %>
        <div class="px-6 py-8 text-center text-gray-400 text-sm">No comments yet.</div>
      <% end %>
    </div>
  </div>

  <!-- Recent Subscribers -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-900">Recent Subscribers</h2>
      <a href="<%= admin_subscribers_path %>" class="text-sm text-amber-600 hover:text-amber-700 font-medium">View all</a>
    </div>
    <div class="divide-y divide-gray-100">
      <% @recent_subscribers.each do |subscriber| %>
        <div class="px-6 py-3 flex items-center justify-between hover:bg-gray-50 transition-colors">
          <div>
            <p class="text-sm font-medium text-gray-900"><%= subscriber.email %></p>
            <p class="text-xs text-gray-500"><%= subscriber.subscribed_at&.strftime("%b %d, %Y") || subscriber.created_at.strftime("%b %d, %Y") %></p>
          </div>
        </div>
      <% end %>
      <% if @recent_subscribers.empty? %>
        <div class="px-6 py-8 text-center text-gray-400 text-sm">No subscribers yet.</div>
      <% end %>
    </div>
  </div>
</div>
