<% content_for(:title) { "#{@video.title} — Boaner" } %>
<% content_for(:meta_title) { "#{@video.title} — Boaner" } %>
<% content_for(:meta_description) { @video.description.to_s.truncate(160) } %>
<% content_for(:meta_image) { @video.thumbnail_url } %>

<section class="max-w-3xl mx-auto px-6 sm:px-8 py-10 md:py-14">
  <!-- Breadcrumb -->
  <div class="mb-6 flex items-center gap-2 text-sm">
    <%= link_to "Videos", videos_path, class: "text-amber-600 hover:text-amber-700 font-medium transition-colors" %>
    <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </div>

  <!-- Video Player -->
  <div data-controller="youtube" data-youtube-id-value="<%= @video.youtube_id %>" class="mb-8">
    <div class="relative aspect-video rounded-2xl overflow-hidden bg-gray-900 cursor-pointer group shadow-2xl" data-action="click->youtube#load">
      <img src="<%= @video.thumbnail_url %>" alt="<%= @video.title %>"
           class="w-full h-full object-cover"
           onerror="this.src='<%= @video.thumbnail_url_hq %>'">
      <div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/40 transition-colors">
        <div class="w-20 h-20 bg-amber-500 rounded-full flex items-center justify-center shadow-lg shadow-amber-500/30 transform group-hover:scale-110 transition-transform duration-300">
          <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </div>
      </div>
    </div>
    <div data-youtube-target="player" class="hidden aspect-video rounded-2xl overflow-hidden"></div>
  </div>

  <!-- Video Info -->
  <div class="mb-8">
    <% if @video.category.present? %>
      <span class="inline-block px-3 py-1 bg-amber-50 text-amber-700 text-xs font-semibold rounded-md uppercase tracking-wide mb-3"><%= @video.category %></span>
    <% end %>
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;"><%= @video.title %></h1>
    <button data-controller="bookmark"
            data-bookmark-id-value="<%= @video.id %>"
            data-bookmark-type-value="video"
            data-bookmark-title-value="<%= @video.title %>"
            data-action="click->bookmark#toggle"
            class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-amber-500 transition-colors mt-3">
      <svg data-bookmark-target="icon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z"/>
      </svg>
      <span>Save for later</span>
    </button>
    <% if @video.published_at %>
      <p class="mt-2 text-sm text-gray-400"><%= @video.published_at.strftime("%B %d, %Y") %></p>
    <% end %>
    <% if @video.description.present? %>
      <div class="mt-6 text-gray-600 leading-relaxed bg-gray-50 rounded-xl p-6 border border-gray-100">
        <%= simple_format(@video.description) %>
      </div>
    <% end %>
  </div>

  <!-- Share Buttons -->
  <div class="border-t border-gray-100 mt-8 pt-6">
    <%= render "shared/share_buttons", title: @video.title, url: video_url(@video) %>
  </div>

  <!-- Related Videos -->
  <%= render "shared/related_videos", videos: @video.related_videos %>

  <!-- Comments -->
  <div class="border-t border-gray-200 mt-10 pt-10">
    <h2 class="text-xl font-bold text-gray-900 mb-8" style="font-family: 'Source Serif 4', Georgia, serif;">Comments</h2>

    <div class="mb-8 bg-gray-50 rounded-xl p-6 border border-gray-100">
      <%= form_with model: [@video, @comment], url: video_comments_path(@video), class: "space-y-4" do |f| %>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <%= f.text_field :name, required: true, placeholder: "Your name", class: "w-full px-4 py-3 rounded-lg border border-gray-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500" %>
          </div>
        </div>
        <%= f.text_area :body, required: true, rows: 3, placeholder: "Write a comment...", class: "w-full px-4 py-3 rounded-lg border border-gray-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 resize-none" %>
        <%= f.submit "Post Comment", class: "px-6 py-2.5 btn-amber text-white text-sm font-semibold rounded-lg cursor-pointer" %>
      <% end %>
    </div>

    <div id="comments" class="space-y-1">
      <% @comments.each do |comment| %>
        <%= render "comments/comment", comment: comment %>
      <% end %>
      <% if @comments.empty? %>
        <p class="text-gray-400 text-sm text-center py-8">No comments yet. Be the first.</p>
      <% end %>
    </div>
  </div>
</section>
