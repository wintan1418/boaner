<% content_for(:title) { "#{@video.title} — Boaner" } %>

<section class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div class="mb-6">
    <%= link_to "Videos", videos_path, class: "text-sm text-ink-400 hover:text-ink-700 transition-colors" %>
    <span class="text-ink-300 mx-1">/</span>
  </div>

  <!-- Video Player -->
  <div data-controller="youtube" data-youtube-id-value="<%= @video.youtube_id %>" class="mb-8">
    <div class="relative aspect-video rounded-md overflow-hidden bg-ink-100 cursor-pointer group" data-action="click->youtube#load">
      <img src="<%= @video.thumbnail_url %>" alt="<%= @video.title %>"
           class="w-full h-full object-cover"
           onerror="this.src='<%= @video.thumbnail_url_hq %>'">
      <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/30 transition-colors">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-ink-800 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </div>
      </div>
    </div>
    <div data-youtube-target="player" class="hidden aspect-video rounded-md overflow-hidden"></div>
  </div>

  <% if @video.category.present? %>
    <p class="text-xs text-ink-400 uppercase tracking-wider mb-2"><%= @video.category %></p>
  <% end %>
  <h1 class="text-2xl md:text-3xl font-bold text-ink-900" style="font-family: 'Source Serif 4', Georgia, serif;"><%= @video.title %></h1>
  <% if @video.published_at %>
    <p class="mt-1 text-sm text-ink-400"><%= @video.published_at.strftime("%B %d, %Y") %></p>
  <% end %>
  <% if @video.description.present? %>
    <div class="mt-4 text-ink-600 leading-relaxed">
      <%= simple_format(@video.description) %>
    </div>
  <% end %>

  <!-- Comments -->
  <div class="border-t border-ink-100 mt-10 pt-8">
    <h2 class="text-lg font-semibold text-ink-900 mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">Comments</h2>

    <div class="mb-8">
      <%= form_with model: [@video, @comment], url: video_comments_path(@video), class: "space-y-4" do |f| %>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <%= f.text_field :name, required: true, placeholder: "Your name", class: "w-full px-3 py-2.5 rounded-md border border-ink-200 text-sm focus:outline-none focus:ring-1 focus:ring-ink-400 focus:border-ink-400" %>
          </div>
        </div>
        <%= f.text_area :body, required: true, rows: 3, placeholder: "Write a comment...", class: "w-full px-3 py-2.5 rounded-md border border-ink-200 text-sm focus:outline-none focus:ring-1 focus:ring-ink-400 focus:border-ink-400 resize-none" %>
        <%= f.submit "Post Comment", class: "px-4 py-2 bg-ink-900 text-white text-sm font-medium rounded-md hover:bg-ink-800 transition-colors cursor-pointer" %>
      <% end %>
    </div>

    <div id="comments">
      <% @comments.each do |comment| %>
        <%= render "comments/comment", comment: comment %>
      <% end %>
      <% if @comments.empty? %>
        <p class="text-ink-400 text-sm text-center py-6">No comments yet. Be the first.</p>
      <% end %>
    </div>
  </div>
</section>
