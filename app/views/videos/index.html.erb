<% content_for(:title) { "Videos — Boaner" } %>

<!-- Hero Header -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0">
    <img src="https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=1920&q=80&auto=format&fit=crop" alt="" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-gray-950/85"></div>
  </div>
  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 py-16 md:py-20">
    <h1 class="text-4xl md:text-5xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">Videos</h1>
    <p class="mt-3 text-gray-300 text-lg">Stories, lectures, and more.</p>
    <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-4"></div>
  </div>
</section>

<section class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 py-12 md:py-16">
  <% if @categories.any? %>
    <div class="flex flex-wrap gap-2 mb-10">
      <%= link_to "All", videos_path,
        class: "px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 #{params[:category].blank? ? 'bg-amber-500 text-white shadow-md shadow-amber-500/20' : 'bg-gray-100 text-gray-600 hover:bg-amber-50 hover:text-amber-700'}",
        data: { turbo_frame: "videos_grid" } %>
      <% @categories.each do |cat| %>
        <%= link_to cat, videos_path(category: cat),
          class: "px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 #{params[:category] == cat ? 'bg-amber-500 text-white shadow-md shadow-amber-500/20' : 'bg-gray-100 text-gray-600 hover:bg-amber-50 hover:text-amber-700'}",
          data: { turbo_frame: "videos_grid" } %>
      <% end %>
    </div>
  <% end %>

  <%= turbo_frame_tag "videos_grid" do %>
    <% if @videos.any? %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @videos.each do |video| %>
          <%= render "videos/card", video: video %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-20 bg-gray-50 rounded-2xl">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        <p class="text-gray-400 font-medium">No videos in this category yet.</p>
      </div>
    <% end %>
  <% end %>
</section>
