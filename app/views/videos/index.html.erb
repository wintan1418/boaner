<% content_for(:title) { "Videos — Boaner" } %>

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
  <div class="mb-10">
    <h1 class="text-3xl font-bold text-ink-900" style="font-family: 'Source Serif 4', Georgia, serif;">Videos</h1>
    <p class="mt-1 text-ink-400">Stories, lectures, and more.</p>
  </div>

  <% if @categories.any? %>
    <div class="flex flex-wrap gap-2 mb-8 border-b border-ink-100 pb-4">
      <%= link_to "All", videos_path,
        class: "px-3 py-1.5 rounded text-sm #{params[:category].blank? ? 'bg-ink-900 text-white' : 'text-ink-500 hover:text-ink-800'}",
        data: { turbo_frame: "videos_grid" } %>
      <% @categories.each do |cat| %>
        <%= link_to cat, videos_path(category: cat),
          class: "px-3 py-1.5 rounded text-sm #{params[:category] == cat ? 'bg-ink-900 text-white' : 'text-ink-500 hover:text-ink-800'}",
          data: { turbo_frame: "videos_grid" } %>
      <% end %>
    </div>
  <% end %>

  <%= turbo_frame_tag "videos_grid" do %>
    <% if @videos.any? %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-8">
        <% @videos.each do |video| %>
          <%= render "videos/card", video: video %>
        <% end %>
      </div>
    <% else %>
      <p class="text-ink-400 py-12 text-center">No videos in this category yet.</p>
    <% end %>
  <% end %>
</section>
