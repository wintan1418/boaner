<%= link_to video_path(video), data: { turbo_frame: "_top" }, class: "group block" do %>
  <div class="relative aspect-[3/4] overflow-hidden rounded-sm bg-gray-100">
    <img src="<%= video.thumbnail_url %>"
         alt="<%= video.title %>"
         loading="lazy"
         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1500ms] ease-out"
         onerror="this.src='<%= video.thumbnail_url_hq %>'">
    <div class="absolute inset-0 bg-gradient-to-t from-gray-950/90 via-gray-950/20 to-transparent"></div>

    <!-- Top meta -->
    <div class="absolute top-5 left-5 right-5 flex items-center justify-between z-10">
      <% if video.category.present? %>
        <span class="text-amber-400 text-[10px] font-semibold tracking-[0.3em] uppercase"><%= video.category %></span>
      <% end %>
      <span class="text-white/60 text-[10px] font-medium tracking-[0.2em]">№ <%= video.id.to_s.rjust(3, '0') %></span>
    </div>

    <!-- Play indicator - appears on hover -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-white flex items-center justify-center transition-all duration-500 scale-75 group-hover:scale-100 opacity-0 group-hover:opacity-100 z-10">
      <svg class="w-5 h-5 text-gray-950 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    </div>

    <!-- Bottom content -->
    <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
      <% if video.published_at %>
        <p class="text-white/60 text-[10px] font-medium tracking-[0.2em] uppercase mb-3"><%= video.published_at.strftime("%b %Y") %></p>
      <% end %>
      <h3 class="display-headline text-white text-xl md:text-2xl leading-[1.1]"><%= video.title %></h3>
    </div>
  </div>
<% end %>
