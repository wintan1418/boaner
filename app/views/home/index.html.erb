<% content_for(:title) { "Boaner — #{@settings.tagline}" } %>

<!-- ═══════════════ HERO — sleek, minimal, cinematic ═══════════════ -->
<section class="relative min-h-screen flex items-center overflow-hidden bg-gray-950" data-controller="slider" data-slider-interval-value="7000">
  <!-- Background slides -->
  <div class="absolute inset-0">
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-[2000ms] ease-in-out opacity-100">
      <img src="https://images.unsplash.com/photo-1473163928189-364b2c4e1135?w=2000&q=85&auto=format&fit=crop" alt="" class="w-full h-full object-cover">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-[2000ms] ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1580136579312-94651dfd596d?w=2000&q=85&auto=format&fit=crop" alt="" class="w-full h-full object-cover">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-[2000ms] ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1509021436665-8f07dbf5bf1d?w=2000&q=85&auto=format&fit=crop" alt="" class="w-full h-full object-cover">
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-950/70 to-gray-950/30"></div>
  </div>

  <!-- Top label -->
  <div class="absolute top-24 left-6 sm:left-10 lg:left-16 z-10 flex items-center gap-3 text-white/50 text-[11px] tracking-[0.3em] uppercase font-medium">
    <span class="w-8 h-px bg-white/40"></span>
    <span>Est. <%= Date.current.year %></span>
  </div>

  <!-- Main content - left aligned -->
  <div class="relative z-10 max-w-6xl mx-auto px-6 sm:px-10 lg:px-16 w-full pt-24">
    <% roles = (@settings.tagline || "YouTuber. Lecturer. Writer.").split(/[.,·•|\/]/).map(&:strip).reject(&:blank?) %>
    <div class="flex items-center gap-3 mb-10 text-amber-400/90 text-[11px] tracking-[0.3em] uppercase font-medium">
      <% roles.each_with_index do |role, i| %>
        <% if i > 0 %><span class="text-amber-400/30">/</span><% end %>
        <span><%= role %></span>
      <% end %>
    </div>

    <h1 class="mega-headline text-white text-[12vw] sm:text-[9vw] md:text-[7.5vw] lg:text-[6vw] max-w-5xl leading-[0.95]">
      <%= @settings.hero_heading %>
    </h1>

    <p class="mt-10 text-base md:text-lg text-white/60 leading-relaxed max-w-xl font-light">
      <%= @settings.hero_subheading %>
    </p>

    <div class="mt-12 flex flex-wrap items-center gap-6">
      <%= link_to videos_path, class: "group inline-flex items-center gap-3 px-6 py-3.5 bg-white text-gray-950 text-sm font-medium rounded-full hover:bg-amber-400 transition-all duration-500" do %>
        <span>Watch the series</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      <% end %>
      <%= link_to posts_path, class: "group inline-flex items-center gap-2 text-white/80 hover:text-amber-400 text-sm font-medium transition-colors duration-500" do %>
        <span class="relative">
          Read the blog
          <span class="absolute left-0 -bottom-1 w-full h-px bg-current scale-x-0 origin-left group-hover:scale-x-100 transition-transform duration-500"></span>
        </span>
      <% end %>
    </div>
  </div>

  <!-- Bottom slider indicators -->
  <div class="absolute bottom-10 left-6 sm:left-10 lg:left-16 flex items-center gap-2 z-10">
    <% 3.times do |i| %>
      <button data-slider-target="dot" data-index="<%= i %>" data-action="click->slider#goTo"
              class="h-[2px] rounded-full transition-all duration-700 <%= i == 0 ? 'bg-white w-12' : 'bg-white/20 w-6' %> hover:bg-white/80"></button>
    <% end %>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-10 right-6 sm:right-10 lg:right-16 flex items-center gap-3 text-white/40 text-[10px] tracking-[0.3em] uppercase z-10">
    <span>Scroll</span>
    <div class="w-px h-8 bg-white/40 relative overflow-hidden">
      <div class="absolute inset-x-0 top-0 h-1/3 bg-white animate-bounce"></div>
    </div>
  </div>
</section>

<!-- ═══════════════ VALUE STATEMENT — calm, whitespace ═══════════════ -->
<section class="bg-white py-28 md:py-40">
  <div class="max-w-5xl mx-auto px-6 sm:px-10 lg:px-16">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start">
      <div class="md:col-span-3">
        <div class="flex items-center gap-3 text-amber-600 text-[11px] tracking-[0.3em] uppercase font-semibold">
          <span class="w-6 h-px bg-amber-500"></span>
          <span>About</span>
        </div>
      </div>
      <div class="md:col-span-9" data-controller="animate">
        <p class="blur-reveal display-headline text-gray-900 text-3xl md:text-4xl lg:text-5xl leading-[1.15] max-w-3xl">
          <%= @settings.bio_long %>
        </p>
        <%= link_to about_path, class: "group inline-flex items-center gap-2 mt-10 text-gray-900 hover:text-amber-600 text-sm font-medium transition-colors" do %>
          <span>More about me</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ LATEST VIDEOS ═══════════════ -->
<section class="bg-gray-50 py-28 md:py-40">
  <div class="max-w-6xl mx-auto px-6 sm:px-10 lg:px-16">
    <div class="flex items-end justify-between mb-16" data-controller="animate">
      <div class="slide-left">
        <div class="flex items-center gap-3 mb-4 text-amber-600 text-[11px] tracking-[0.3em] uppercase font-semibold">
          <span class="w-6 h-px bg-amber-500"></span>
          <span>Watch</span>
        </div>
        <h2 class="display-headline text-gray-900 text-4xl md:text-5xl lg:text-6xl">
          Latest videos
        </h2>
      </div>
      <%= link_to videos_path, class: "hidden md:inline-flex items-center gap-2 text-gray-900 hover:text-amber-600 text-sm font-medium transition-colors group" do %>
        <span>All videos</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      <% end %>
    </div>

    <% if @videos.any? %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 stagger-smooth" data-controller="animate">
        <% @videos.each do |video| %>
          <div><%= render "videos/poster", video: video %></div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-400 text-center py-16">Videos coming soon.</p>
    <% end %>
  </div>
</section>

<!-- ═══════════════ FEATURED VIDEO — full-bleed cinematic ═══════════════ -->
<% featured_video = Video.published.featured.first %>
<% if featured_video %>
  <section class="relative bg-gray-950 overflow-hidden">
    <div data-controller="youtube" data-youtube-id-value="<%= featured_video.youtube_id %>" class="relative min-h-[70vh] flex items-center group cursor-pointer" data-action="click->youtube#load">
      <div class="absolute inset-0">
        <img src="<%= featured_video.thumbnail_url %>" alt=""
             class="w-full h-full object-cover opacity-40 group-hover:opacity-55 transition-opacity duration-1000"
             onerror="this.src='<%= featured_video.thumbnail_url_hq %>'">
        <div class="absolute inset-0 bg-gradient-to-r from-gray-950 via-gray-950/80 to-gray-950/20"></div>
      </div>

      <div data-youtube-target="player" class="hidden absolute inset-0 z-20"></div>

      <div class="relative max-w-6xl mx-auto px-6 sm:px-10 lg:px-16 py-24 md:py-32 z-10 w-full">
        <div class="max-w-2xl">
          <div class="flex items-center gap-3 mb-8 text-amber-400 text-[11px] tracking-[0.3em] uppercase font-semibold">
            <span class="w-6 h-px bg-amber-400"></span>
            <span>Featured episode</span>
          </div>
          <h2 class="display-headline text-white text-4xl md:text-5xl lg:text-6xl leading-[1.05] mb-8">
            <%= featured_video.title %>
          </h2>
          <% if featured_video.description.present? %>
            <p class="text-white/60 text-base md:text-lg leading-relaxed line-clamp-3 max-w-xl font-light">
              <%= featured_video.description %>
            </p>
          <% end %>
          <div class="flex items-center gap-5 mt-12">
            <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center group-hover:bg-amber-400 transition-colors duration-500">
              <svg class="w-6 h-6 text-gray-950 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <div>
              <p class="text-white text-sm font-medium">Play the film</p>
              <p class="text-white/40 text-xs mt-1">Stream on YouTube</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- ═══════════════ BLOG ═══════════════ -->
<section class="bg-white py-28 md:py-40">
  <div class="max-w-6xl mx-auto px-6 sm:px-10 lg:px-16">
    <div class="flex items-end justify-between mb-16" data-controller="animate">
      <div class="slide-right">
        <div class="flex items-center gap-3 mb-4 text-amber-600 text-[11px] tracking-[0.3em] uppercase font-semibold">
          <span class="w-6 h-px bg-amber-500"></span>
          <span>Read</span>
        </div>
        <h2 class="display-headline text-gray-900 text-4xl md:text-5xl lg:text-6xl">
          Essays &amp; stories
        </h2>
      </div>
      <%= link_to posts_path, class: "hidden md:inline-flex items-center gap-2 text-gray-900 hover:text-amber-600 text-sm font-medium transition-colors group" do %>
        <span>All posts</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      <% end %>
    </div>

    <% if @posts.any? %>
      <div class="grid md:grid-cols-2 gap-8 stagger-smooth" data-controller="animate">
        <% @posts.each do |post| %>
          <div><%= render "posts/card", post: post %></div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-400 text-center py-16">Blog posts coming soon.</p>
    <% end %>
  </div>
</section>

<!-- ═══════════════ TESTIMONIALS — minimal ═══════════════ -->
<section class="bg-gray-50 py-28 md:py-40">
  <div class="max-w-6xl mx-auto px-6 sm:px-10 lg:px-16">
    <div class="max-w-2xl mb-16" data-controller="animate">
      <div class="blur-reveal">
        <div class="flex items-center gap-3 mb-4 text-amber-600 text-[11px] tracking-[0.3em] uppercase font-semibold">
          <span class="w-6 h-px bg-amber-500"></span>
          <span>Voices</span>
        </div>
        <h2 class="display-headline text-gray-900 text-4xl md:text-5xl lg:text-6xl">
          What people are saying
        </h2>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6 md:gap-8 stagger-smooth" data-controller="animate">
      <div class="bg-white p-10 rounded-sm">
        <p class="text-gray-800 text-lg leading-relaxed" style="font-family: 'Source Serif 4', Georgia, serif; font-weight: 400;">"The way you bring history to life is incredible. I've learned more from your videos than I did in years of school."</p>
        <div class="mt-10 pt-6 border-t border-gray-100">
          <p class="text-sm font-medium text-gray-900">Adewale K.</p>
          <p class="text-xs text-gray-400 mt-1">YouTube Subscriber</p>
        </div>
      </div>

      <div class="bg-gray-950 text-white p-10 rounded-sm md:translate-y-8">
        <p class="text-lg leading-relaxed" style="font-family: 'Source Serif 4', Georgia, serif; font-weight: 400;">"Your course on African History changed my perspective entirely. The depth of research and storytelling craft is unmatched."</p>
        <div class="mt-10 pt-6 border-t border-white/10">
          <p class="text-sm font-medium text-white">Sarah M.</p>
          <p class="text-xs text-amber-400 mt-1">Course Student</p>
        </div>
      </div>

      <div class="bg-white p-10 rounded-sm">
        <p class="text-gray-800 text-lg leading-relaxed" style="font-family: 'Source Serif 4', Georgia, serif; font-weight: 400;">"I bought 'Echoes of Empire' after watching the Napoleon video. Finished it in two days. You have a gift."</p>
        <div class="mt-10 pt-6 border-t border-gray-100">
          <p class="text-sm font-medium text-gray-900">James O.</p>
          <p class="text-xs text-gray-400 mt-1">Book Reader</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ BOOKS — dark ═══════════════ -->
<% if @books.any? %>
  <section class="relative py-28 md:py-40 overflow-hidden bg-gray-950">
    <div class="max-w-6xl mx-auto px-6 sm:px-10 lg:px-16">
      <div class="flex items-end justify-between mb-16" data-controller="animate">
        <div class="slide-left">
          <div class="flex items-center gap-3 mb-4 text-amber-400 text-[11px] tracking-[0.3em] uppercase font-semibold">
            <span class="w-6 h-px bg-amber-400"></span>
            <span>Library</span>
          </div>
          <h2 class="display-headline text-white text-4xl md:text-5xl lg:text-6xl">
            Published works
          </h2>
        </div>
        <%= link_to books_path, class: "hidden md:inline-flex items-center gap-2 text-white hover:text-amber-400 text-sm font-medium transition-colors group" do %>
          <span>All books</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        <% end %>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10 stagger-smooth" data-controller="animate">
        <% @books.each do |book| %>
          <div><%= render "books/card", book: book %></div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- ═══════════════ NEWSLETTER — clean ═══════════════ -->
<section class="bg-white py-28 md:py-40">
  <div class="max-w-3xl mx-auto px-6 sm:px-10 lg:px-16 text-center" data-controller="animate">
    <div class="blur-reveal">
      <div class="inline-flex items-center gap-3 mb-6 text-amber-600 text-[11px] tracking-[0.3em] uppercase font-semibold">
        <span class="w-6 h-px bg-amber-500"></span>
        <span>Newsletter</span>
        <span class="w-6 h-px bg-amber-500"></span>
      </div>
      <h2 class="display-headline text-gray-900 text-4xl md:text-5xl lg:text-6xl leading-[1.05]">
        Never miss a story
      </h2>
      <p class="mt-6 text-gray-500 text-base md:text-lg leading-relaxed max-w-xl mx-auto font-light">
        New videos, essays, and books — straight to your inbox.
      </p>
      <div class="mt-12 max-w-md mx-auto">
        <%= render "subscribers/form" %>
      </div>
      <p class="mt-6 text-gray-400 text-xs tracking-[0.2em] uppercase">No spam · Unsubscribe anytime</p>
    </div>
  </div>
</section>
