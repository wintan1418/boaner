<% content_for(:title) { "Boaner — #{@settings.tagline}" } %>

<!-- ═══════════════ HERO ═══════════════ -->
<section class="relative min-h-screen flex items-end overflow-hidden noise-overlay" data-controller="slider" data-slider-interval-value="6500">
  <!-- Sliding Background Images -->
  <div class="absolute inset-0">
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-100">
      <img src="https://images.unsplash.com/photo-1473163928189-364b2c4e1135?w=1920&q=80&auto=format&fit=crop"
           alt="" class="w-full h-full object-cover scale-105">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1580136579312-94651dfd596d?w=1920&q=80&auto=format&fit=crop"
           alt="" class="w-full h-full object-cover scale-105">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=1920&q=80&auto=format&fit=crop"
           alt="" class="w-full h-full object-cover scale-105">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1509021436665-8f07dbf5bf1d?w=1920&q=80&auto=format&fit=crop"
           alt="" class="w-full h-full object-cover scale-105">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1576485290814-1c72aa4bbb8e?w=1920&q=80&auto=format&fit=crop"
           alt="" class="w-full h-full object-cover scale-105">
    </div>
    <!-- Gradient overlay with noise -->
    <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-950/85 to-gray-950/40"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-gray-950/70 via-transparent to-transparent"></div>
  </div>

  <!-- Top label — "EST." -->
  <div class="absolute top-28 left-6 sm:left-8 lg:left-12 z-10">
    <div class="flex items-center gap-3 text-amber-400/70 text-xs tracking-[0.3em] uppercase font-semibold">
      <span class="w-8 h-px bg-amber-400/50"></span>
      <span>Est. <%= Date.current.year %></span>
    </div>
  </div>

  <!-- Right side decorative meta -->
  <div class="absolute top-28 right-6 sm:right-8 lg:right-12 z-10 text-right hidden md:block">
    <p class="text-amber-400/70 text-xs tracking-[0.3em] uppercase font-semibold">№ 01</p>
    <p class="text-white/50 text-xs mt-1 italic" style="font-family: 'Source Serif 4', Georgia, serif;">A personal record</p>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 pb-24 md:pb-32 pt-32 w-full z-10">
    <!-- Roles — top divider -->
    <% roles = (@settings.tagline || "YouTuber. Lecturer. Writer.").split(/[.,·•|\/]/).map(&:strip).reject(&:blank?) %>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-8 text-amber-400 text-sm font-medium">
      <% roles.each_with_index do |role, i| %>
        <% if i > 0 %>
          <span class="text-amber-400/40">·</span>
        <% end %>
        <span><%= role %></span>
      <% end %>
    </div>

    <!-- Editorial headline -->
    <h1 class="display-headline text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-white max-w-4xl">
      <%= @settings.hero_heading %>
    </h1>

    <p class="mt-8 text-lg md:text-xl text-gray-300 leading-relaxed max-w-2xl font-light">
      <%= @settings.hero_subheading %>
    </p>

    <div class="mt-12 flex flex-wrap items-center gap-4">
      <%= link_to videos_path, class: "arrow-link inline-flex items-center gap-3 px-8 py-4 btn-amber text-white font-semibold rounded-full text-sm uppercase tracking-wider" do %>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <span>Watch Videos</span>
      <% end %>
      <%= link_to posts_path, class: "arrow-link inline-flex items-center gap-3 px-8 py-4 text-white text-sm font-semibold rounded-full border border-white/20 hover:border-amber-500 hover:bg-amber-500/10 backdrop-blur-sm transition-all uppercase tracking-wider" do %>
        <span>Read the Blog</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      <% end %>
    </div>
  </div>

  <!-- Slider dots -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2 z-10">
    <% 5.times do |i| %>
      <button data-slider-target="dot" data-index="<%= i %>" data-action="click->slider#goTo"
              class="h-1 rounded-full transition-all duration-500 <%= i == 0 ? 'bg-amber-500 w-10' : 'bg-white/30 w-5' %> hover:bg-amber-400"></button>
    <% end %>
  </div>

  <!-- Scroll indicator — bottom right -->
  <div class="absolute bottom-8 right-6 sm:right-8 lg:right-12 hidden md:flex items-center gap-3 text-white/50 text-xs tracking-[0.2em] uppercase z-10">
    <span>Scroll</span>
    <div class="w-8 h-px bg-white/30 relative overflow-hidden">
      <div class="absolute inset-y-0 left-0 w-1/3 bg-amber-400 animate-marquee" style="animation-duration: 2s;"></div>
    </div>
  </div>
</section>

<!-- ═══════════════ STATS — minimal band ═══════════════ -->
<section class="relative bg-gray-950 border-t border-b border-amber-500/20 py-6 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-amber-500/10" data-controller="animate">
      <div class="scale-reveal text-center py-4 md:py-2">
        <p class="text-3xl md:text-4xl font-bold text-white display-headline"><%= Video.count %>+</p>
        <p class="text-amber-400/70 text-xs mt-2 tracking-[0.2em] uppercase">Videos</p>
      </div>
      <div class="scale-reveal text-center py-4 md:py-2">
        <p class="text-3xl md:text-4xl font-bold text-white display-headline"><%= Post.count %>+</p>
        <p class="text-amber-400/70 text-xs mt-2 tracking-[0.2em] uppercase">Essays</p>
      </div>
      <div class="scale-reveal text-center py-4 md:py-2">
        <p class="text-3xl md:text-4xl font-bold text-white display-headline"><%= Course.count %></p>
        <p class="text-amber-400/70 text-xs mt-2 tracking-[0.2em] uppercase">Courses</p>
      </div>
      <div class="scale-reveal text-center py-4 md:py-2">
        <p class="text-3xl md:text-4xl font-bold text-white display-headline"><%= Book.count %></p>
        <p class="text-amber-400/70 text-xs mt-2 tracking-[0.2em] uppercase">Books</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ LATEST VIDEOS ═══════════════ -->
<section class="bg-white py-24 md:py-32 relative">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <%= render "shared/section_heading",
        number: "01",
        eyebrow: "Watch",
        title: "Latest Videos",
        subtitle: "Stories and lessons from my YouTube channel.",
        link_text: "View all",
        link_path: videos_path %>

    <% if @videos.any? %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 stagger-smooth" data-controller="animate">
        <% @videos.each do |video| %>
          <div><%= render "videos/card", video: video %></div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-gray-50 rounded-2xl">
        <p class="text-gray-400 font-medium">Videos coming soon.</p>
      </div>
    <% end %>
  </div>
</section>

<!-- ═══════════════ PULL QUOTE BREAK ═══════════════ -->
<section class="relative bg-gradient-to-b from-white to-amber-50/30 py-20 md:py-24 overflow-hidden">
  <div class="max-w-4xl mx-auto px-6 sm:px-8 lg:px-12 text-center relative">
    <div class="quote-mark absolute -top-4 left-1/2 -translate-x-1/2 select-none">"</div>
    <p data-controller="animate" class="blur-reveal pull-quote text-gray-900 relative z-10 max-w-3xl mx-auto">
      History is not a record of what happened. It is a negotiation between memory and power — and every generation gets to rewrite it.
    </p>
    <div class="mt-8 flex items-center justify-center gap-3 text-amber-600 text-xs tracking-[0.25em] uppercase">
      <span class="w-8 h-px bg-amber-500"></span>
      <span class="font-semibold">From the Blog</span>
      <span class="w-8 h-px bg-amber-500"></span>
    </div>
  </div>
</section>

<!-- ═══════════════ BLOG ═══════════════ -->
<section class="bg-amber-50/30 py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <%= render "shared/section_heading",
        number: "02",
        eyebrow: "Read",
        title: "From the Blog",
        subtitle: "Stories, essays, and reflections on history and the present.",
        link_text: "Read more",
        link_path: posts_path %>

    <% if @posts.any? %>
      <div class="grid md:grid-cols-2 gap-8 stagger-smooth" data-controller="animate">
        <% @posts.each do |post| %>
          <div><%= render "posts/card", post: post %></div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-white rounded-2xl">
        <p class="text-gray-400 font-medium">Blog posts coming soon.</p>
      </div>
    <% end %>
  </div>
</section>

<!-- ═══════════════ FEATURED VIDEO ═══════════════ -->
<% featured_video = Video.published.featured.first %>
<% if featured_video %>
  <section class="relative mesh-amber py-24 md:py-32 noise-overlay overflow-hidden">
    <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 z-10">
      <div class="grid md:grid-cols-12 gap-12 items-center">
        <div data-controller="animate" class="slide-left md:col-span-5">
          <div class="flex items-center gap-3 mb-4">
            <span class="section-number text-amber-400/70">03 —</span>
            <span class="section-eyebrow text-amber-400">Featured</span>
          </div>
          <h2 class="display-headline text-4xl md:text-5xl text-white leading-[1.05]">
            <%= featured_video.title %>
          </h2>
          <% if featured_video.description.present? %>
            <p class="text-gray-300 mt-6 leading-relaxed line-clamp-4 text-base max-w-lg">
              <%= featured_video.description %>
            </p>
          <% end %>
          <%= link_to video_path(featured_video), class: "arrow-link inline-flex items-center gap-3 mt-8 px-7 py-3.5 bg-white text-gray-900 font-semibold rounded-full text-sm uppercase tracking-wider hover:bg-amber-400 transition-colors" do %>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            <span>Watch Now</span>
          <% end %>
        </div>
        <div data-controller="animate" class="scale-reveal md:col-span-7">
          <div data-controller="youtube" data-youtube-id-value="<%= featured_video.youtube_id %>" class="relative">
            <!-- Decorative frame -->
            <div class="absolute -inset-4 border border-amber-500/30 rounded-sm hidden md:block"></div>
            <div class="aspect-video rounded-sm overflow-hidden cursor-pointer group shadow-2xl relative" data-action="click->youtube#load">
              <img src="<%= featured_video.thumbnail_url %>" alt="<%= featured_video.title %>"
                   class="w-full h-full object-cover thumbnail-zoom"
                   onerror="this.src='<%= featured_video.thumbnail_url_hq %>'">
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                <div class="w-20 h-20 bg-amber-500 rounded-full flex items-center justify-center shadow-2xl shadow-amber-500/50 group-hover:scale-110 transition-transform">
                  <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>
            </div>
            <div data-youtube-target="player" class="hidden aspect-video rounded-sm overflow-hidden"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- ═══════════════ TESTIMONIALS ═══════════════ -->
<section class="bg-white py-24 md:py-32 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="text-center mb-16 max-w-2xl mx-auto" data-controller="animate">
      <div class="blur-reveal">
        <div class="flex items-center justify-center gap-3 text-amber-600 text-xs tracking-[0.3em] uppercase mb-4">
          <span class="w-8 h-px bg-amber-500"></span>
          <span class="font-semibold">Voices</span>
          <span class="w-8 h-px bg-amber-500"></span>
        </div>
        <h2 class="display-headline text-4xl md:text-5xl text-gray-900">What people are saying</h2>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-8 stagger-smooth" data-controller="animate">
      <div class="bg-amber-50/50 rounded-sm p-8 border-l-2 border-amber-500 relative">
        <p class="text-gray-700 leading-relaxed text-base" style="font-family: 'Source Serif 4', Georgia, serif;">"The way you bring history to life is incredible. I've learned more from your videos than I did in years of school. Every episode feels like a movie."</p>
        <div class="mt-6 flex items-center gap-3 pt-4 border-t border-amber-200/50">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center ring-2 ring-white">
            <span class="text-white text-sm font-bold">A</span>
          </div>
          <div>
            <p class="text-sm font-bold text-gray-900">Adewale K.</p>
            <p class="text-xs text-gray-500 uppercase tracking-wider">YouTube Subscriber</p>
          </div>
        </div>
      </div>

      <div class="bg-amber-50/50 rounded-sm p-8 border-l-2 border-amber-500 relative">
        <p class="text-gray-700 leading-relaxed text-base" style="font-family: 'Source Serif 4', Georgia, serif;">"Your course on African History changed my perspective entirely. The depth of research and the storytelling craft is unmatched."</p>
        <div class="mt-6 flex items-center gap-3 pt-4 border-t border-amber-200/50">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center ring-2 ring-white">
            <span class="text-white text-sm font-bold">S</span>
          </div>
          <div>
            <p class="text-sm font-bold text-gray-900">Sarah M.</p>
            <p class="text-xs text-gray-500 uppercase tracking-wider">Course Student</p>
          </div>
        </div>
      </div>

      <div class="bg-amber-50/50 rounded-sm p-8 border-l-2 border-amber-500 relative">
        <p class="text-gray-700 leading-relaxed text-base" style="font-family: 'Source Serif 4', Georgia, serif;">"I bought 'Echoes of Empire' after watching the Napoleon video. Finished it in two days. You have a gift for making history feel urgent."</p>
        <div class="mt-6 flex items-center gap-3 pt-4 border-t border-amber-200/50">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-green-500 to-emerald-500 flex items-center justify-center ring-2 ring-white">
            <span class="text-white text-sm font-bold">J</span>
          </div>
          <div>
            <p class="text-sm font-bold text-gray-900">James O.</p>
            <p class="text-xs text-gray-500 uppercase tracking-wider">Book Reader</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════ BOOKS (dark) ═══════════════ -->
<% if @books.any? %>
  <section class="relative py-24 md:py-32 overflow-hidden mesh-amber noise-overlay">
    <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 z-10">
      <%= render "shared/section_heading",
          number: "04",
          eyebrow: "Read",
          title: "Published Works",
          subtitle: "Books, essays, and long-form writing.",
          link_text: "All books",
          link_path: books_path,
          dark: true %>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 stagger-smooth" data-controller="animate">
        <% @books.each do |book| %>
          <div><%= render "books/card", book: book %></div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- ═══════════════ TICKER ═══════════════ -->
<section class="bg-amber-500 py-4 overflow-hidden">
  <div class="animate-marquee flex items-center gap-8 whitespace-nowrap">
    <% ["History", "Stories", "Knowledge", "Africa", "Revolution", "Culture", "Legacy", "Truth", "History", "Stories", "Knowledge", "Africa", "Revolution", "Culture", "Legacy", "Truth"].each do |word| %>
      <span class="text-white text-sm font-bold uppercase tracking-[0.3em]"><%= word %></span>
      <span class="text-white/40 text-lg">&#9670;</span>
    <% end %>
  </div>
</section>

<!-- ═══════════════ NEWSLETTER ═══════════════ -->
<section class="bg-white py-24 md:py-32 relative overflow-hidden">
  <!-- Mesh background -->
  <div class="absolute inset-0 mesh-warm opacity-40"></div>

  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div data-controller="animate" class="slide-left">
        <div class="flex items-center gap-3 text-amber-600 text-xs tracking-[0.3em] uppercase mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span class="font-semibold">Newsletter</span>
        </div>
        <h2 class="display-headline text-4xl md:text-5xl lg:text-6xl text-gray-900 leading-[1.05]">
          Never miss<br>a new story.
        </h2>
        <p class="mt-6 text-gray-600 leading-relaxed max-w-md text-lg font-light">
          Join the community. New videos, blog posts, and books — straight to your inbox.
        </p>
        <p class="mt-2 text-xs text-gray-400 uppercase tracking-wider">No spam. Unsubscribe anytime.</p>
      </div>
      <div class="relative">
        <!-- Decorative corner ornaments -->
        <span class="corner-ornament corner-ornament-tl"></span>
        <span class="corner-ornament corner-ornament-br"></span>
        <div class="bg-gray-950 rounded-sm p-10 shadow-2xl relative">
          <p class="text-white font-semibold mb-2 text-lg" style="font-family: 'Source Serif 4', Georgia, serif;">Subscribe for free</p>
          <p class="text-gray-400 text-sm mb-8">Delivered weekly to your inbox.</p>
          <%= render "subscribers/form" %>
        </div>
      </div>
    </div>
  </div>
</section>
