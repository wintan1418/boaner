<% content_for(:title) { "Boaner — #{@settings.tagline}" } %>

<!-- Hero Section with Image Slider -->
<section class="relative min-h-[90vh] flex items-center overflow-hidden" data-controller="slider" data-slider-interval-value="6000">
  <!-- Sliding Background Images -->
  <div class="absolute inset-0">
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-100">
      <img src="https://images.unsplash.com/photo-1473163928189-364b2c4e1135?w=1920&q=80&auto=format&fit=crop"
           alt="Ink and feather" class="w-full h-full object-cover">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1580136579312-94651dfd596d?w=1920&q=80&auto=format&fit=crop"
           alt="African art and storytelling" class="w-full h-full object-cover">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=1920&q=80&auto=format&fit=crop"
           alt="Books and stories" class="w-full h-full object-cover">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1509021436665-8f07dbf5bf1d?w=1920&q=80&auto=format&fit=crop"
           alt="Vintage writing desk" class="w-full h-full object-cover">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1576485290814-1c72aa4bbb8e?w=1920&q=80&auto=format&fit=crop"
           alt="African history" class="w-full h-full object-cover">
    </div>
    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-gray-950/95 via-gray-950/85 to-gray-950/60"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 py-20 md:py-32 w-full">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="px-3 py-1 bg-amber-500/20 border border-amber-500/30 text-amber-400 font-semibold tracking-wide text-xs rounded-full">YouTuber</span>
        <span class="px-3 py-1 bg-amber-500/20 border border-amber-500/30 text-amber-400 font-semibold tracking-wide text-xs rounded-full">Lecturer</span>
        <span class="px-3 py-1 bg-amber-500/20 border border-amber-500/30 text-amber-400 font-semibold tracking-wide text-xs rounded-full">Writer</span>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight" style="font-family: 'Source Serif 4', Georgia, serif;">
        <%= @settings.hero_heading %>
      </h1>
      <p class="mt-6 text-gray-300 text-lg leading-relaxed max-w-xl">
        <%= @settings.hero_subheading %>
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <%= link_to videos_path, class: "inline-flex items-center gap-2 px-7 py-3.5 btn-amber text-white font-semibold rounded-xl text-sm" do %>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          Watch Videos
        <% end %>
        <%= link_to "Read the Blog", posts_path, class: "inline-flex items-center gap-2 px-7 py-3.5 text-white text-sm font-semibold rounded-xl border-2 border-white/20 hover:border-amber-500 hover:text-amber-400 backdrop-blur-sm transition-all duration-300" %>
      </div>
    </div>
  </div>

  <!-- Slider dots -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2">
    <% 5.times do |i| %>
      <button data-slider-target="dot" data-index="<%= i %>" data-action="click->slider#goTo"
              class="h-2.5 rounded-full transition-all duration-300 <%= i == 0 ? 'bg-amber-500 w-8' : 'bg-white/40 w-2.5' %> hover:bg-amber-400"></button>
    <% end %>
  </div>

  <!-- Slider arrows -->
  <button data-action="click->slider#prev" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/30 backdrop-blur-sm text-white/70 hover:text-white hover:bg-black/50 flex items-center justify-center transition-all hidden md:flex">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <button data-action="click->slider#next" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/30 backdrop-blur-sm text-white/70 hover:text-white hover:bg-black/50 flex items-center justify-center transition-all hidden md:flex">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>
</section>

<!-- Stats Strip -->
<section class="relative bg-gradient-to-r from-amber-500 via-amber-600 to-orange-500">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 py-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center" data-controller="animate">
      <div class="scale-reveal">
        <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Video.count %>+</p>
        <p class="text-amber-100 text-sm font-medium mt-1">Videos</p>
      </div>
      <div class="scale-reveal">
        <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Post.count %>+</p>
        <p class="text-amber-100 text-sm font-medium mt-1">Blog Posts</p>
      </div>
      <div class="scale-reveal">
        <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Course.count %></p>
        <p class="text-amber-100 text-sm font-medium mt-1">Courses</p>
      </div>
      <div class="scale-reveal">
        <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Book.count %></p>
        <p class="text-amber-100 text-sm font-medium mt-1">Books</p>
      </div>
    </div>
  </div>
</section>

<!-- Latest Videos Section -->
<section class="bg-white py-20 md:py-24">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-end justify-between mb-12" data-controller="animate">
      <div class="blur-reveal">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;">Latest Videos</h2>
        <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-3"></div>
      </div>
      <%= link_to "View all &rarr;".html_safe, videos_path, class: "text-sm font-semibold text-amber-600 hover:text-amber-700 transition-colors" %>
    </div>

    <% if @videos.any? %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 stagger-smooth" data-controller="animate">
        <% @videos.each do |video| %>
          <div>
            <%= render "videos/card", video: video %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-gray-50 rounded-2xl">
        <p class="text-gray-400 font-medium">Videos coming soon.</p>
      </div>
    <% end %>
  </div>
</section>

<!-- Wave Divider -->
<div class="bg-white">
  <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
    <path d="M0 40C240 80 480 0 720 40C960 80 1200 0 1440 40V80H0V40Z" fill="#f9fafb"/>
  </svg>
</div>

<!-- Blog Section -->
<section class="bg-gray-50 py-20 md:py-24">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-end justify-between mb-12" data-controller="animate">
      <div class="slide-right">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;">From the Blog</h2>
        <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-3"></div>
      </div>
      <%= link_to "Read more &rarr;".html_safe, posts_path, class: "text-sm font-semibold text-amber-600 hover:text-amber-700 transition-colors" %>
    </div>

    <% if @posts.any? %>
      <div class="grid md:grid-cols-2 gap-6 stagger-smooth" data-controller="animate">
        <% @posts.each do |post| %>
          <div>
            <%= render "posts/card", post: post %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-white rounded-2xl">
        <p class="text-gray-400 font-medium">Blog posts coming soon.</p>
      </div>
    <% end %>
  </div>
</section>

<!-- Featured Video -->
<% featured_video = Video.published.featured.first %>
<% if featured_video %>
  <section class="bg-gray-950 py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <img src="<%= featured_video.thumbnail_url %>" alt="" class="w-full h-full object-cover blur-2xl scale-110">
    </div>
    <div class="relative max-w-5xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div data-controller="animate" class="slide-left">
          <span class="text-amber-500 text-xs font-semibold uppercase tracking-widest">Featured</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mt-3 leading-tight" style="font-family: 'Source Serif 4', Georgia, serif;"><%= featured_video.title %></h2>
          <% if featured_video.description.present? %>
            <p class="text-gray-400 mt-4 leading-relaxed line-clamp-3"><%= featured_video.description %></p>
          <% end %>
          <%= link_to video_path(featured_video), class: "inline-flex items-center gap-2 mt-6 px-6 py-3 btn-amber text-white font-semibold rounded-xl text-sm" do %>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            Watch Now
          <% end %>
        </div>
        <div data-controller="animate" class="scale-reveal">
          <div data-controller="youtube" data-youtube-id-value="<%= featured_video.youtube_id %>" class="relative">
            <div class="aspect-video rounded-2xl overflow-hidden cursor-pointer group shadow-2xl glow-border" data-action="click->youtube#load">
              <img src="<%= featured_video.thumbnail_url %>" alt="<%= featured_video.title %>"
                   class="w-full h-full object-cover"
                   onerror="this.src='<%= featured_video.thumbnail_url_hq %>'">
              <div class="absolute inset-0 bg-black/30 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                <div class="w-16 h-16 bg-amber-500 rounded-full flex items-center justify-center shadow-lg shadow-amber-500/40 group-hover:scale-110 transition-transform">
                  <svg class="w-7 h-7 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>
            </div>
            <div data-youtube-target="player" class="hidden aspect-video rounded-2xl overflow-hidden"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- Testimonials -->
<section class="bg-white py-20 md:py-24 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="text-center mb-14" data-controller="animate">
      <div class="blur-reveal">
        <span class="text-amber-500 text-xs font-semibold uppercase tracking-widest">What People Say</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-3" style="font-family: 'Source Serif 4', Georgia, serif;">Voices from the Community</h2>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-8 stagger-smooth" data-controller="animate">
      <div class="bg-gray-50 rounded-2xl p-7 border border-gray-100 relative">
        <svg class="w-8 h-8 text-amber-200 mb-4" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
        <p class="text-gray-600 leading-relaxed text-sm">"The way you bring history to life is incredible. I've learned more from your videos than I did in years of school. Every episode feels like a movie."</p>
        <div class="mt-5 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center">
            <span class="text-white text-sm font-bold">A</span>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-900">Adewale K.</p>
            <p class="text-xs text-gray-400">YouTube Subscriber</p>
          </div>
        </div>
      </div>

      <div class="bg-gray-50 rounded-2xl p-7 border border-gray-100 relative">
        <svg class="w-8 h-8 text-amber-200 mb-4" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
        <p class="text-gray-600 leading-relaxed text-sm">"Your course on African History changed my perspective entirely. The depth of research and the storytelling craft is unmatched. Thank you for doing this work."</p>
        <div class="mt-5 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center">
            <span class="text-white text-sm font-bold">S</span>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-900">Sarah M.</p>
            <p class="text-xs text-gray-400">Course Student</p>
          </div>
        </div>
      </div>

      <div class="bg-gray-50 rounded-2xl p-7 border border-gray-100 relative">
        <svg class="w-8 h-8 text-amber-200 mb-4" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
        <p class="text-gray-600 leading-relaxed text-sm">"I bought 'Echoes of Empire' after watching the Napoleon video. Finished it in two days. You have a gift for making history feel urgent and personal."</p>
        <div class="mt-5 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-green-500 to-emerald-500 flex items-center justify-center">
            <span class="text-white text-sm font-bold">J</span>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-900">James O.</p>
            <p class="text-xs text-gray-400">Book Reader</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Books Section -->
<% if @books.any? %>
  <section class="relative py-20 md:py-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src="https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=1920&q=80&auto=format&fit=crop"
           alt="" class="w-full h-full object-cover">
      <div class="absolute inset-0 bg-gray-950/90"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="flex items-end justify-between mb-12" data-controller="animate">
        <div class="blur-reveal">
          <h2 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">Books</h2>
          <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-3"></div>
        </div>
        <%= link_to "All books &rarr;".html_safe, books_path, class: "text-sm font-semibold text-amber-400 hover:text-amber-300 transition-colors" %>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 stagger-smooth" data-controller="animate">
        <% @books.each do |book| %>
          <div>
            <%= render "books/card", book: book %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Scrolling Ticker -->
<section class="bg-amber-500 py-4 overflow-hidden">
  <div class="animate-marquee flex items-center gap-8 whitespace-nowrap">
    <% ["History", "Stories", "Knowledge", "Africa", "Revolution", "Culture", "Legacy", "Truth", "History", "Stories", "Knowledge", "Africa", "Revolution", "Culture", "Legacy", "Truth"].each do |word| %>
      <span class="text-white/80 text-sm font-bold uppercase tracking-widest"><%= word %></span>
      <span class="text-white/40">&#9670;</span>
    <% end %>
  </div>
</section>

<!-- Newsletter Section — Light to break the dark-dark-dark -->
<section class="bg-white py-20 md:py-28 relative overflow-hidden">
  <!-- Subtle background decoration -->
  <div class="absolute top-0 left-0 w-72 h-72 bg-amber-50 rounded-full -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-amber-50 rounded-full translate-x-1/3 translate-y-1/3"></div>

  <div class="relative max-w-4xl mx-auto px-6 sm:px-8">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div data-controller="animate" class="slide-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50 border border-amber-200 mb-6">
          <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span class="text-amber-700 text-xs font-semibold tracking-wide uppercase">Newsletter</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight" style="font-family: 'Source Serif 4', Georgia, serif;">
          Never miss a<br>new story.
        </h2>
        <p class="mt-4 text-gray-500 leading-relaxed">
          Join the community. Get notified when new videos drop, blog posts go live, or a new book hits the shelves.
        </p>
      </div>
      <div>
        <div class="bg-gray-950 rounded-2xl p-8 shadow-2xl">
          <p class="text-white font-semibold mb-1">Subscribe for free</p>
          <p class="text-gray-400 text-sm mb-6">No spam. Unsubscribe anytime.</p>
          <%= render "subscribers/form" %>
        </div>
      </div>
    </div>
  </div>
</section>
