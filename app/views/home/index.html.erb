<% content_for(:title) { "Boaner — #{@settings.tagline}" } %>

<!-- Hero Section -->
<section class="relative bg-gray-950 hero-pattern min-h-[85vh] flex items-center overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-orange-500/8 rounded-full blur-3xl"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 w-full">
    <div class="grid md:grid-cols-5 gap-12 md:gap-16 items-center">
      <div class="md:col-span-3">
        <div class="flex items-center gap-2 mb-6">
          <span class="text-amber-500 font-semibold tracking-wide text-sm">YouTuber</span>
          <span class="text-gray-600">&middot;</span>
          <span class="text-amber-500 font-semibold tracking-wide text-sm">Lecturer</span>
          <span class="text-gray-600">&middot;</span>
          <span class="text-amber-500 font-semibold tracking-wide text-sm">Writer</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight" style="font-family: 'Source Serif 4', Georgia, serif;">
          <%= @settings.hero_heading %>
        </h1>
        <p class="mt-6 text-gray-400 text-lg leading-relaxed max-w-lg">
          <%= @settings.hero_subheading %>
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <%= link_to videos_path, class: "inline-flex items-center gap-2 px-7 py-3.5 btn-amber text-white font-semibold rounded-xl text-sm" do %>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            Watch Videos
          <% end %>
          <%= link_to "Read the Blog", posts_path, class: "inline-flex items-center gap-2 px-7 py-3.5 text-white text-sm font-semibold rounded-xl border-2 border-gray-700 hover:border-amber-500 hover:text-amber-400 transition-all duration-300" %>
        </div>
      </div>
      <div class="md:col-span-2">
        <div class="relative">
          <!-- Decorative border -->
          <div class="absolute -inset-3 bg-gradient-to-br from-amber-500/20 to-orange-500/20 rounded-2xl blur-sm"></div>
          <div class="relative aspect-[4/5] rounded-2xl overflow-hidden ring-2 ring-amber-500/30">
            <%= render "shared/profile_image" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats Strip -->
<section class="relative bg-gradient-to-r from-amber-500 via-amber-600 to-orange-500">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div>
        <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;"><%= @videos.respond_to?(:total_count) ? @videos.total_count : Video.count %></p>
        <p class="text-amber-100 text-sm font-medium mt-1">Videos</p>
      </div>
      <div>
        <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Post.count %></p>
        <p class="text-amber-100 text-sm font-medium mt-1">Blog Posts</p>
      </div>
      <div>
        <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Course.count %></p>
        <p class="text-amber-100 text-sm font-medium mt-1">Courses</p>
      </div>
      <div>
        <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;"><%= Book.count %></p>
        <p class="text-amber-100 text-sm font-medium mt-1">Books</p>
      </div>
    </div>
  </div>
</section>

<!-- Latest Videos Section -->
<section class="bg-white py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between mb-12">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;">Latest Videos</h2>
        <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-3"></div>
      </div>
      <%= link_to "View all &rarr;".html_safe, videos_path, class: "text-sm font-semibold text-amber-600 hover:text-amber-700 transition-colors" %>
    </div>

    <% if @videos.any? %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @videos.each do |video| %>
          <div data-controller="animate">
            <%= render "videos/card", video: video %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-gray-50 rounded-2xl">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        <p class="text-gray-400 font-medium">Videos coming soon.</p>
      </div>
    <% end %>
  </div>
</section>

<!-- Wave Divider -->
<div class="bg-white">
  <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
    <path d="M0 40C240 80 480 0 720 40C960 80 1200 0 1440 40V80H0V40Z" fill="#f9fafb"/>
  </svg>
</div>

<!-- Blog Section -->
<section class="bg-gray-50 py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between mb-12">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;">From the Blog</h2>
        <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-3"></div>
      </div>
      <%= link_to "Read more &rarr;".html_safe, posts_path, class: "text-sm font-semibold text-amber-600 hover:text-amber-700 transition-colors" %>
    </div>

    <% if @posts.any? %>
      <div class="grid md:grid-cols-2 gap-6">
        <% @posts.each do |post| %>
          <div data-controller="animate">
            <%= render "posts/card", post: post %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-white rounded-2xl">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        <p class="text-gray-400 font-medium">Blog posts coming soon.</p>
      </div>
    <% end %>
  </div>
</section>

<!-- Books Section (Dark) -->
<% if @books.any? %>
  <!-- Wave into dark -->
  <div class="bg-gray-50">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
      <path d="M0 40C360 0 720 80 1080 40C1260 20 1380 30 1440 40V80H0V40Z" fill="#030712"/>
    </svg>
  </div>

  <section class="bg-gray-950 py-20 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">Books</h2>
          <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-3"></div>
        </div>
        <%= link_to "All books &rarr;".html_safe, books_path, class: "text-sm font-semibold text-amber-400 hover:text-amber-300 transition-colors" %>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @books.each do |book| %>
          <div data-controller="animate">
            <%= render "books/card", book: book %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Newsletter/CTA Section -->
<section class="relative bg-gradient-to-br from-amber-500 via-amber-600 to-orange-500 overflow-hidden">
  <!-- Decorative circles -->
  <div class="absolute top-0 left-0 w-64 h-64 bg-white/10 rounded-full -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-white/5 rounded-full translate-x-1/3 translate-y-1/3"></div>

  <div class="relative max-w-2xl mx-auto px-4 sm:px-6 py-20 md:py-24 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900" style="font-family: 'Source Serif 4', Georgia, serif;">Stay Updated</h2>
    <p class="mt-4 text-amber-900/80 text-lg max-w-md mx-auto">New videos, posts, and books — straight to your inbox. No spam, ever.</p>
    <div class="mt-8">
      <%= render "subscribers/form" %>
    </div>
  </div>
</section>
