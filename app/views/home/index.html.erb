<% content_for(:title) { "Boaner — #{@settings.tagline}" } %>

<!-- ═══════════════════════════════════════════════
     CINEMATIC HERO — full viewport, massive type
     ═══════════════════════════════════════════════ -->
<section class="relative h-screen min-h-[700px] flex items-center justify-center overflow-hidden bg-gray-950" data-controller="slider" data-slider-interval-value="7000">
  <!-- Sliding backgrounds with slow-zoom breathing -->
  <div class="absolute inset-0 noise-overlay">
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-[1500ms] ease-in-out opacity-100">
      <img src="https://images.unsplash.com/photo-1473163928189-364b2c4e1135?w=2000&q=85&auto=format&fit=crop" alt="" class="w-full h-full object-cover hero-breathe">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-[1500ms] ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1580136579312-94651dfd596d?w=2000&q=85&auto=format&fit=crop" alt="" class="w-full h-full object-cover hero-breathe">
    </div>
    <div data-slider-target="slide" class="absolute inset-0 transition-opacity duration-[1500ms] ease-in-out opacity-0">
      <img src="https://images.unsplash.com/photo-1509021436665-8f07dbf5bf1d?w=2000&q=85&auto=format&fit=crop" alt="" class="w-full h-full object-cover hero-breathe">
    </div>
    <!-- Deep gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-gray-950/80 via-gray-950/60 to-gray-950"></div>
  </div>

  <!-- Top frame: decorative corners -->
  <div class="absolute top-24 left-6 sm:left-10 lg:left-14 z-10">
    <div class="flex items-center gap-3 text-amber-400/80 text-[10px] tracking-[0.35em] uppercase font-bold">
      <span class="w-10 h-px bg-amber-400/60"></span>
      <span>Est. <%= Date.current.year %></span>
    </div>
  </div>
  <div class="absolute top-24 right-6 sm:right-10 lg:right-14 z-10 text-right">
    <p class="text-amber-400/80 text-[10px] tracking-[0.35em] uppercase font-bold">Volume 01</p>
  </div>

  <!-- Side rotated label -->
  <div class="absolute left-6 top-1/2 -translate-y-1/2 z-10 hidden lg:block">
    <p class="vertical-text text-white/40 text-[10px] tracking-[0.4em] uppercase font-semibold">Stories · History · Culture</p>
  </div>

  <!-- MAIN TITLE — centered, massive -->
  <div class="relative z-10 text-center px-6 max-w-6xl mx-auto">
    <% roles = (@settings.tagline || "YouTuber. Lecturer. Writer.").split(/[.,·•|\/]/).map(&:strip).reject(&:blank?) %>
    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 mb-10 text-amber-400/90 text-xs font-bold tracking-[0.35em] uppercase">
      <% roles.each_with_index do |role, i| %>
        <% if i > 0 %><span class="text-amber-400/40">◆</span><% end %>
        <span><%= role %></span>
      <% end %>
    </div>

    <h1 class="mega-headline text-white text-[15vw] sm:text-[13vw] md:text-[11vw] lg:text-[9vw] leading-[0.85]">
      <%= @settings.hero_heading %>
    </h1>

    <p class="mt-10 text-lg md:text-xl text-gray-300 leading-relaxed max-w-2xl mx-auto font-light">
      <%= @settings.hero_subheading %>
    </p>

    <div class="mt-14 flex flex-wrap items-center justify-center gap-4">
      <%= link_to videos_path, class: "mega-cta" do %>
        <span>Watch the series</span>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      <% end %>
      <%= link_to posts_path, class: "ghost-cta" do %>
        <span>Read more</span>
      <% end %>
    </div>
  </div>

  <!-- Slider navigation — bottom -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex items-center gap-2 z-10">
    <% 3.times do |i| %>
      <button data-slider-target="dot" data-index="<%= i %>" data-action="click->slider#goTo"
              class="h-[2px] rounded-full transition-all duration-700 <%= i == 0 ? 'bg-amber-500 w-16' : 'bg-white/25 w-8' %> hover:bg-amber-400"></button>
    <% end %>
  </div>

  <!-- Scroll down indicator -->
  <div class="absolute bottom-8 right-6 sm:right-10 lg:right-14 flex items-center gap-3 text-white/50 text-[10px] tracking-[0.3em] uppercase font-bold z-10">
    <span>Scroll</span>
    <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     FILM STRIP — marquee of keywords
     ═══════════════════════════════════════════════ -->
<section class="bg-black py-6 overflow-hidden border-y border-amber-500/20">
  <div class="marquee-track">
    <% 2.times do %>
      <% ["History", "◆", "Untold Stories", "◆", "African Heritage", "◆", "Documentary", "◆", "Revolution", "◆", "Kingdoms", "◆", "Legacy", "◆", "Truth", "◆"].each do |word| %>
        <% if word == "◆" %>
          <span class="text-amber-500 text-2xl">◆</span>
        <% else %>
          <span class="display-headline text-5xl md:text-6xl text-white hover:text-amber-400 transition-colors"><%= word %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     LATEST VIDEOS — film poster grid
     ═══════════════════════════════════════════════ -->
<section class="bg-gray-50 py-28 md:py-40 relative">
  <!-- Giant decorative 01 -->
  <div class="absolute top-12 -right-6 mega-section-number select-none pointer-events-none">01</div>

  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-end justify-between mb-16" data-controller="animate">
      <div class="slide-left">
        <div class="flex items-center gap-3 mb-5">
          <span class="w-12 h-px bg-amber-500"></span>
          <span class="text-amber-600 text-[11px] tracking-[0.35em] uppercase font-bold">The Videos</span>
        </div>
        <h2 class="mega-headline text-5xl md:text-7xl lg:text-8xl text-gray-900">
          Watch<br><em class="text-amber-600 not-italic" style="font-family: 'Source Serif 4', Georgia, serif; font-style: italic;">&amp;</em> Listen.
        </h2>
      </div>
      <%= link_to videos_path, class: "hidden md:inline-flex arrow-link items-center gap-2 text-amber-600 hover:text-amber-700 text-xs font-bold tracking-[0.2em] uppercase" do %>
        <span>View all</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      <% end %>
    </div>

    <% if @videos.any? %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 stagger-smooth" data-controller="animate">
        <% @videos.each do |video| %>
          <div><%= render "videos/poster", video: video %></div>
        <% end %>
      </div>

      <div class="mt-12 md:hidden text-center">
        <%= link_to "View all videos →".html_safe, videos_path, class: "text-amber-600 font-bold text-sm tracking-[0.2em] uppercase" %>
      </div>
    <% else %>
      <p class="text-gray-400 text-center py-16">Videos coming soon.</p>
    <% end %>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     MASSIVE PULL QUOTE — full-bleed dark
     ═══════════════════════════════════════════════ -->
<section class="relative bg-gray-950 py-32 md:py-48 overflow-hidden noise-overlay">
  <!-- Giant quote mark behind -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 text-amber-500/10 select-none pointer-events-none" style="font-family: 'Source Serif 4', Georgia, serif; font-size: clamp(20rem, 40vw, 40rem); line-height: 0.7; font-style: italic;">"</div>

  <div class="relative max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 text-center z-10">
    <p data-controller="animate" class="blur-reveal mega-headline text-white text-3xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1]" style="font-style: italic;">
      History is not a record of what happened.<br>
      It is a <span class="text-amber-400">negotiation</span> between memory <span class="text-amber-400">and power</span> —<br>
      and every generation gets to rewrite it.
    </p>
    <div class="mt-12 flex items-center justify-center gap-4 text-amber-400/80 text-[10px] tracking-[0.4em] uppercase font-bold">
      <span class="w-12 h-px bg-amber-400/60"></span>
      <span>From The Blog</span>
      <span class="w-12 h-px bg-amber-400/60"></span>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     BLOG — magazine feature layout
     ═══════════════════════════════════════════════ -->
<section class="bg-white py-28 md:py-40 relative">
  <!-- Giant decorative 02 -->
  <div class="absolute top-12 -left-6 mega-section-number select-none pointer-events-none">02</div>

  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-end justify-between mb-16" data-controller="animate">
      <div class="slide-right">
        <div class="flex items-center gap-3 mb-5">
          <span class="w-12 h-px bg-amber-500"></span>
          <span class="text-amber-600 text-[11px] tracking-[0.35em] uppercase font-bold">The Writing</span>
        </div>
        <h2 class="mega-headline text-5xl md:text-7xl lg:text-8xl text-gray-900">
          Essays<br><em class="text-amber-600 not-italic" style="font-family: 'Source Serif 4', Georgia, serif; font-style: italic;">&amp;</em> Stories.
        </h2>
      </div>
      <%= link_to posts_path, class: "hidden md:inline-flex arrow-link items-center gap-2 text-amber-600 hover:text-amber-700 text-xs font-bold tracking-[0.2em] uppercase" do %>
        <span>Read all</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      <% end %>
    </div>

    <% if @posts.any? %>
      <div class="grid md:grid-cols-2 gap-8 md:gap-10 stagger-smooth" data-controller="animate">
        <% @posts.each do |post| %>
          <div><%= render "posts/card", post: post %></div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-400 text-center py-16">Blog posts coming soon.</p>
    <% end %>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     FEATURED VIDEO — full bleed cinematic
     ═══════════════════════════════════════════════ -->
<% featured_video = Video.published.featured.first %>
<% if featured_video %>
  <section class="relative bg-black overflow-hidden">
    <div data-controller="youtube" data-youtube-id-value="<%= featured_video.youtube_id %>" class="relative min-h-[80vh] flex items-center cursor-pointer group" data-action="click->youtube#load">
      <!-- Background image with scale -->
      <div class="absolute inset-0">
        <img src="<%= featured_video.thumbnail_url %>" alt=""
             class="w-full h-full object-cover opacity-50 group-hover:opacity-60 transition-opacity duration-700 hero-breathe"
             onerror="this.src='<%= featured_video.thumbnail_url_hq %>'">
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/70 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
      </div>

      <div data-youtube-target="player" class="hidden absolute inset-0 z-20"></div>

      <!-- Content -->
      <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 py-24 md:py-32 z-10 w-full">
        <div class="max-w-3xl">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-12 h-px bg-amber-500"></span>
            <span class="text-amber-400 text-[11px] tracking-[0.35em] uppercase font-bold">Featured Episode</span>
          </div>
          <h2 class="mega-headline text-white text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[0.95] mb-8">
            <%= featured_video.title %>
          </h2>
          <% if featured_video.description.present? %>
            <p class="text-gray-300 text-lg leading-relaxed line-clamp-3 max-w-xl mb-10 font-light">
              <%= featured_video.description %>
            </p>
          <% end %>
          <div class="flex items-center gap-6">
            <div class="w-20 h-20 md:w-24 md:h-24 bg-amber-500 rounded-full flex items-center justify-center shadow-2xl shadow-amber-500/50 group-hover:scale-110 transition-transform duration-500">
              <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <div>
              <p class="text-white text-xs font-bold tracking-[0.3em] uppercase">Play the film</p>
              <p class="text-white/60 text-xs mt-1">Stream on YouTube</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- ═══════════════════════════════════════════════
     TESTIMONIALS
     ═══════════════════════════════════════════════ -->
<section class="bg-amber-50/40 py-28 md:py-40 relative overflow-hidden">
  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="text-center mb-20 max-w-3xl mx-auto" data-controller="animate">
      <div class="blur-reveal">
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="w-12 h-px bg-amber-500"></span>
          <span class="text-amber-600 text-[11px] tracking-[0.35em] uppercase font-bold">Voices</span>
          <span class="w-12 h-px bg-amber-500"></span>
        </div>
        <h2 class="mega-headline text-5xl md:text-6xl text-gray-900 leading-[1.05]">
          What they're saying.
        </h2>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6 md:gap-8 stagger-smooth" data-controller="animate">
      <div class="bg-white p-10 border-t-2 border-amber-500">
        <p class="text-5xl text-amber-500 leading-none mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">"</p>
        <p class="text-gray-800 leading-relaxed text-lg" style="font-family: 'Source Serif 4', Georgia, serif;">The way you bring history to life is incredible. I've learned more from your videos than I did in years of school.</p>
        <div class="mt-8 pt-6 border-t border-gray-100">
          <p class="text-sm font-bold text-gray-900">Adewale K.</p>
          <p class="text-[10px] text-gray-500 tracking-[0.2em] uppercase mt-1">YouTube Subscriber</p>
        </div>
      </div>

      <div class="bg-gray-950 text-white p-10 border-t-2 border-amber-500 md:translate-y-8">
        <p class="text-5xl text-amber-400 leading-none mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">"</p>
        <p class="leading-relaxed text-lg" style="font-family: 'Source Serif 4', Georgia, serif;">Your course on African History changed my perspective entirely. The depth of research and storytelling craft is unmatched.</p>
        <div class="mt-8 pt-6 border-t border-white/10">
          <p class="text-sm font-bold text-white">Sarah M.</p>
          <p class="text-[10px] text-amber-400 tracking-[0.2em] uppercase mt-1">Course Student</p>
        </div>
      </div>

      <div class="bg-white p-10 border-t-2 border-amber-500">
        <p class="text-5xl text-amber-500 leading-none mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">"</p>
        <p class="text-gray-800 leading-relaxed text-lg" style="font-family: 'Source Serif 4', Georgia, serif;">I bought 'Echoes of Empire' after watching the Napoleon video. Finished it in two days. You have a gift.</p>
        <div class="mt-8 pt-6 border-t border-gray-100">
          <p class="text-sm font-bold text-gray-900">James O.</p>
          <p class="text-[10px] text-gray-500 tracking-[0.2em] uppercase mt-1">Book Reader</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     BOOKS — dark bookshelf
     ═══════════════════════════════════════════════ -->
<% if @books.any? %>
  <section class="relative py-28 md:py-40 overflow-hidden mesh-amber noise-overlay">
    <div class="absolute top-12 -right-6 mega-section-number select-none pointer-events-none" style="color: rgba(255, 255, 255, 0.04);">03</div>

    <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 z-10">
      <div class="flex items-end justify-between mb-16" data-controller="animate">
        <div class="slide-left">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-12 h-px bg-amber-400"></span>
            <span class="text-amber-400 text-[11px] tracking-[0.35em] uppercase font-bold">The Library</span>
          </div>
          <h2 class="mega-headline text-5xl md:text-7xl lg:text-8xl text-white">
            Published<br><em class="text-amber-400 not-italic" style="font-family: 'Source Serif 4', Georgia, serif; font-style: italic;">&amp;</em> Printed.
          </h2>
        </div>
        <%= link_to books_path, class: "hidden md:inline-flex arrow-link items-center gap-2 text-amber-400 hover:text-amber-300 text-xs font-bold tracking-[0.2em] uppercase" do %>
          <span>All books</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        <% end %>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10 stagger-smooth" data-controller="animate">
        <% @books.each do |book| %>
          <div><%= render "books/card", book: book %></div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- ═══════════════════════════════════════════════
     NEWSLETTER — dramatic full-bleed
     ═══════════════════════════════════════════════ -->
<section class="relative bg-white py-28 md:py-40 overflow-hidden">
  <div class="absolute inset-0 mesh-warm opacity-50"></div>

  <div class="relative max-w-4xl mx-auto px-6 sm:px-8 lg:px-12 text-center z-10">
    <div class="flex items-center justify-center gap-3 mb-8" data-controller="animate">
      <div class="blur-reveal">
        <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </div>
    </div>
    <h2 class="mega-headline text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-gray-900 leading-[0.9]">
      Never miss<br>a <em class="text-amber-600" style="font-family: 'Source Serif 4', Georgia, serif;">story.</em>
    </h2>
    <p class="mt-10 text-gray-600 text-lg leading-relaxed max-w-lg mx-auto">
      Join the community. Get new videos, essays, and books straight to your inbox.
    </p>
    <div class="mt-12 max-w-md mx-auto">
      <%= render "subscribers/form" %>
    </div>
    <p class="mt-6 text-gray-400 text-xs tracking-[0.2em] uppercase">No spam. Unsubscribe anytime.</p>
  </div>
</section>
