<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Georgia, serif; color: #1f2937; line-height: 1.7; margin: 0; padding: 0; background: #f9fafb; }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; }
    .header { background: #111827; padding: 30px; text-align: center; }
    .header h1 { color: #f59e0b; font-size: 24px; margin: 0; }
    .content { padding: 30px; }
    .content h2 { font-size: 22px; color: #111827; margin-top: 0; }
    .footer { padding: 20px 30px; background: #f3f4f6; text-align: center; font-size: 12px; color: #9ca3af; }
    .footer a { color: #f59e0b; text-decoration: none; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1><%= @settings.site_name %></h1>
    </div>
    <div class="content">
      <%= @newsletter.body %>
    </div>
    <div class="footer">
      <p>You're receiving this because you subscribed to <%= @settings.site_name %>.</p>
      <p>&copy; <%= Date.current.year %> <%= @settings.site_name %>. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
