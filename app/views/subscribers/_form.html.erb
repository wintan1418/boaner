<%= turbo_frame_tag "newsletter_form" do %>
  <%= form_with url: subscribers_path, class: "space-y-3" do |f| %>
    <%= f.email_field :email,
      placeholder: "your@email.com",
      required: true,
      class: "w-full px-4 py-3 rounded-xl bg-gray-800 border border-gray-700 text-white placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500/40 focus:border-amber-500 transition-all" %>
    <%= f.submit "Subscribe",
      class: "w-full px-6 py-3 btn-amber text-white text-sm font-semibold rounded-xl cursor-pointer" %>
  <% end %>
<% end %>
