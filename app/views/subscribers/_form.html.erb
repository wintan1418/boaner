<%= turbo_frame_tag "newsletter_form" do %>
  <%= form_with url: subscribers_path, class: "flex flex-col sm:flex-row gap-3 max-w-md mx-auto" do |f| %>
    <%= f.email_field :email,
      placeholder: "your@email.com",
      required: true,
      class: "flex-1 px-4 py-3 rounded-lg border border-gray-700 bg-gray-800 text-white placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500" %>
    <%= f.submit "Subscribe",
      class: "px-6 py-3 bg-gray-900 text-amber-400 text-sm font-bold rounded-lg hover:bg-gray-800 hover:text-amber-300 transition-all cursor-pointer border border-gray-700" %>
  <% end %>
<% end %>
