<%= link_to post_path(post), data: { turbo_frame: "_top" }, class: "group block bg-white rounded-xl p-6 border-l-[3px] border-amber-400 hover:border-amber-500 shadow-sm hover:shadow-md transition-all duration-300" do %>
  <div class="flex items-center gap-3 text-xs mb-3">
    <% if post.category.present? %>
      <span class="px-2.5 py-1 bg-amber-50 text-amber-700 font-semibold rounded-md uppercase tracking-wide"><%= post.category %></span>
    <% end %>
    <% if post.published_at %>
      <span class="text-gray-400"><%= post.published_at.strftime("%b %d, %Y") %></span>
    <% end %>
    <span class="text-gray-300">&middot;</span>
    <span class="text-gray-400"><%= post.reading_time %></span>
  </div>
  <h3 class="text-lg font-bold text-gray-900 group-hover:text-amber-600 transition-colors leading-snug" style="font-family: 'Source Serif 4', Georgia, serif;"><%= post.title %></h3>
  <% if post.excerpt.present? %>
    <p class="mt-2 text-sm text-gray-500 leading-relaxed line-clamp-2"><%= post.excerpt %></p>
  <% end %>
  <div class="mt-4 text-sm font-semibold text-amber-600 group-hover:text-amber-700 transition-colors flex items-center gap-1">
    Read more
    <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </div>
<% end %>
