<% content_for(:title) { "Blog — Boaner" } %>

<!-- Hero Header -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0">
    <img src="https://images.unsplash.com/photo-1455390582262-044cdead277a?w=1920&q=80&auto=format&fit=crop" alt="" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-gray-950/85"></div>
  </div>
  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 py-16 md:py-20">
    <h1 class="text-4xl md:text-5xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">Blog</h1>
    <p class="mt-3 text-gray-300 text-lg">Stories, essays, and reflections.</p>
    <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-4"></div>
  </div>
</section>

<section class="max-w-4xl mx-auto px-6 sm:px-8 lg:px-12 py-12 md:py-16">
  <% if @categories.any? %>
    <div class="flex flex-wrap gap-2 mb-10">
      <%= link_to "All", posts_path,
        class: "px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 #{params[:category].blank? ? 'bg-amber-500 text-white shadow-md shadow-amber-500/20' : 'bg-gray-100 text-gray-600 hover:bg-amber-50 hover:text-amber-700'}",
        data: { turbo_frame: "posts_list" } %>
      <% @categories.each do |cat| %>
        <%= link_to cat, posts_path(category: cat),
          class: "px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 #{params[:category] == cat ? 'bg-amber-500 text-white shadow-md shadow-amber-500/20' : 'bg-gray-100 text-gray-600 hover:bg-amber-50 hover:text-amber-700'}",
          data: { turbo_frame: "posts_list" } %>
      <% end %>
    </div>
  <% end %>

  <%= turbo_frame_tag "posts_list" do %>
    <% if @posts.any? %>
      <div class="space-y-5">
        <% @posts.each do |post| %>
          <%= render "posts/card", post: post %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-20 bg-gray-50 rounded-2xl">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        <p class="text-gray-400 font-medium">No posts in this category yet.</p>
      </div>
    <% end %>
  <% end %>
</section>
