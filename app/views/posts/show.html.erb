<% content_for(:title) { "#{@post.title} — Boaner" } %>
<% content_for(:meta_title) { "#{@post.title} — Boaner" } %>
<% content_for(:meta_description) { @post.excerpt.to_s.truncate(160) } %>

<article class="max-w-2xl mx-auto px-6 sm:px-8 py-10 md:py-14">
  <!-- Breadcrumb -->
  <div class="mb-6 flex items-center gap-2 text-sm">
    <%= link_to "Blog", posts_path, class: "text-amber-600 hover:text-amber-700 font-medium transition-colors" %>
    <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </div>

  <header class="mb-10">
    <div class="flex items-center gap-3 text-xs mb-4">
      <% if @post.category.present? %>
        <span class="px-2.5 py-1 bg-amber-50 text-amber-700 font-semibold rounded-md uppercase tracking-wide"><%= @post.category %></span>
      <% end %>
      <% if @post.published_at %>
        <span class="text-gray-400"><%= @post.published_at.strftime("%B %d, %Y") %></span>
      <% end %>
      <span class="text-gray-300">&middot;</span>
      <span class="text-gray-400"><%= @post.reading_time %></span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight" style="font-family: 'Source Serif 4', Georgia, serif;"><%= @post.title %></h1>
    <button data-controller="bookmark"
            data-bookmark-id-value="<%= @post.slug %>"
            data-bookmark-type-value="post"
            data-bookmark-title-value="<%= @post.title %>"
            data-action="click->bookmark#toggle"
            class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-amber-500 transition-colors mt-3">
      <svg data-bookmark-target="icon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z"/>
      </svg>
      <span>Save for later</span>
    </button>
    <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-5"></div>
  </header>

  <div class="prose-content text-gray-700">
    <%= @post.body %>
  </div>

  <!-- Share Buttons -->
  <div class="border-t border-gray-100 mt-8 pt-6">
    <%= render "shared/share_buttons", title: @post.title, url: post_url(@post) %>
  </div>

  <!-- Related Posts -->
  <%= render "shared/related_posts", posts: @post.related_posts %>

  <!-- Comments -->
  <div class="border-t border-gray-200 mt-14 pt-10">
    <h2 class="text-xl font-bold text-gray-900 mb-8" style="font-family: 'Source Serif 4', Georgia, serif;">Comments</h2>

    <div class="mb-8 bg-gray-50 rounded-xl p-6 border border-gray-100">
      <%= form_with model: [@post, @comment], url: post_comments_path(@post), class: "space-y-4" do |f| %>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <%= f.text_field :name, required: true, placeholder: "Your name", class: "w-full px-4 py-3 rounded-lg border border-gray-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500" %>
          </div>
        </div>
        <%= f.text_area :body, required: true, rows: 3, placeholder: "Write a comment...", class: "w-full px-4 py-3 rounded-lg border border-gray-200 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 resize-none" %>
        <%= f.submit "Post Comment", class: "px-6 py-2.5 btn-amber text-white text-sm font-semibold rounded-lg cursor-pointer" %>
      <% end %>
    </div>

    <div id="comments" class="space-y-1">
      <% @comments.each do |comment| %>
        <%= render "comments/comment", comment: comment %>
      <% end %>
      <% if @comments.empty? %>
        <p class="text-gray-400 text-sm text-center py-8">No comments yet. Be the first.</p>
      <% end %>
    </div>
  </div>
</article>
