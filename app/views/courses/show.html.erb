<% content_for(:title) { "#{@course.title} — Boaner" } %>

<section class="max-w-4xl mx-auto px-6 sm:px-8 py-10 md:py-14">
  <!-- Breadcrumb -->
  <div class="mb-6 flex items-center gap-2 text-sm">
    <%= link_to "Courses", courses_path, class: "text-amber-600 hover:text-amber-700 font-medium transition-colors" %>
    <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </div>

  <!-- Course Header -->
  <div class="bg-gradient-to-br from-gray-900 to-gray-950 rounded-2xl p-8 md:p-10 mb-10">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      </div>
      <span class="px-3 py-1 bg-amber-500/20 text-amber-400 text-xs font-semibold rounded-md"><%= @lessons.count %> lesson<%= @lessons.count == 1 ? '' : 's' %></span>
    </div>
    <h1 class="text-2xl md:text-3xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;"><%= @course.title %></h1>
    <% if @course.description.present? %>
      <p class="mt-3 text-gray-400 leading-relaxed max-w-2xl"><%= @course.description %></p>
    <% end %>
  </div>

  <!-- Lessons List -->
  <h2 class="text-lg font-bold text-gray-900 mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">Lessons</h2>
  <div class="space-y-3">
    <% @lessons.each_with_index do |lesson, i| %>
      <%= link_to course_lesson_path(@course, lesson), class: "group flex items-center gap-4 p-4 bg-white rounded-xl border border-gray-100 hover:border-amber-200 hover:shadow-md transition-all duration-300" do %>
        <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 text-white flex items-center justify-center text-sm font-bold shrink-0 shadow-sm"><%= i + 1 %></span>
        <div class="flex-1 min-w-0">
          <span class="text-sm font-semibold text-gray-900 group-hover:text-amber-600 transition-colors"><%= lesson.title %></span>
          <% if lesson.free_preview? %>
            <span class="ml-2 px-2 py-0.5 bg-green-50 text-green-700 text-xs font-medium rounded">Free preview</span>
          <% end %>
        </div>
        <svg class="w-5 h-5 text-gray-300 group-hover:text-amber-500 transform group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <% end %>
    <% end %>
  </div>
</section>
