<% content_for(:title) { "#{@course.title} — Boaner" } %>

<section class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14">
  <div class="mb-6">
    <%= link_to "Courses", courses_path, class: "text-sm text-stone-400 hover:text-stone-700 transition-colors" %>
    <span class="text-stone-300 mx-1">/</span>
  </div>

  <h1 class="text-2xl md:text-3xl font-bold text-stone-900" style="font-family: 'Source Serif 4', Georgia, serif;"><%= @course.title %></h1>
  <% if @course.description.present? %>
    <p class="mt-2 text-stone-500 leading-relaxed"><%= @course.description %></p>
  <% end %>
  <p class="mt-1 text-sm text-stone-400"><%= @lessons.count %> lesson<%= @lessons.count == 1 ? '' : 's' %></p>

  <div class="mt-8 divide-y divide-stone-100">
    <% @lessons.each_with_index do |lesson, i| %>
      <%= link_to course_lesson_path(@course, lesson), class: "group flex items-center gap-4 py-4 hover:bg-stone-50 -mx-3 px-3 rounded transition-colors" do %>
        <span class="w-8 h-8 rounded-full bg-stone-100 text-stone-500 flex items-center justify-center text-sm font-medium shrink-0"><%= i + 1 %></span>
        <div class="flex-1 min-w-0">
          <span class="text-sm font-medium text-stone-800 group-hover:text-stone-900"><%= lesson.title %></span>
          <% if lesson.free_preview? %>
            <span class="ml-2 text-xs text-stone-400">Free preview</span>
          <% end %>
        </div>
        <svg class="w-4 h-4 text-stone-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <% end %>
    <% end %>
  </div>
</section>
