<% content_for(:title) { "Courses — Boaner" } %>

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
  <div class="mb-10">
    <h1 class="text-3xl font-bold text-stone-900" style="font-family: 'Source Serif 4', Georgia, serif;">Courses</h1>
    <p class="mt-1 text-stone-400">Structured learning, at your own pace.</p>
  </div>

  <% if @courses.any? %>
    <div class="grid sm:grid-cols-2 gap-6">
      <% @courses.each do |course| %>
        <%= link_to course_path(course), class: "group block border border-stone-200 rounded-md p-6 hover:border-stone-300 transition-colors" do %>
          <h3 class="text-lg font-semibold text-stone-900 group-hover:text-stone-600 transition-colors" style="font-family: 'Source Serif 4', Georgia, serif;"><%= course.title %></h3>
          <% if course.description.present? %>
            <p class="mt-2 text-sm text-stone-500 leading-relaxed line-clamp-2"><%= course.description %></p>
          <% end %>
          <p class="mt-3 text-xs text-stone-400"><%= course.lessons.count %> lesson<%= course.lessons.count == 1 ? '' : 's' %></p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-stone-400 py-12 text-center">Courses coming soon.</p>
  <% end %>
</section>
