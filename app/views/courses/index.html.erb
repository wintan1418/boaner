<% content_for(:title) { "Courses — Boaner" } %>

<!-- Hero Header -->
<section class="bg-gray-950 hero-pattern relative overflow-hidden">
  <div class="absolute top-10 left-1/2 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 relative">
    <h1 class="text-4xl md:text-5xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">Courses</h1>
    <p class="mt-3 text-gray-400 text-lg">Structured learning, at your own pace.</p>
    <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-4"></div>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
  <% if @courses.any? %>
    <div class="grid sm:grid-cols-2 gap-8">
      <% @courses.each do |course| %>
        <%= link_to course_path(course), class: "group block bg-white rounded-xl p-8 border border-gray-100 shadow-sm hover:shadow-lg hover:border-amber-200 transition-all duration-300 card-hover" do %>
          <div class="flex items-start justify-between">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center mb-5 shadow-md shadow-amber-500/20">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            </div>
            <svg class="w-5 h-5 text-gray-300 group-hover:text-amber-500 transform group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 group-hover:text-amber-600 transition-colors" style="font-family: 'Source Serif 4', Georgia, serif;"><%= course.title %></h3>
          <% if course.description.present? %>
            <p class="mt-3 text-sm text-gray-500 leading-relaxed line-clamp-2"><%= course.description %></p>
          <% end %>
          <div class="mt-5 flex items-center gap-2">
            <span class="px-3 py-1 bg-amber-50 text-amber-700 text-xs font-semibold rounded-md"><%= course.lessons.count %> lesson<%= course.lessons.count == 1 ? '' : 's' %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 bg-white rounded-2xl border border-gray-100">
      <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      <p class="text-gray-400 font-medium">Courses coming soon.</p>
    </div>
  <% end %>
</section>
