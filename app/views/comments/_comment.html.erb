<div id="<%= dom_id(comment) %>" class="py-5 border-b border-gray-100 last:border-0">
  <div class="flex items-center gap-3 mb-2">
    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center">
      <span class="text-white text-xs font-bold"><%= comment.name.first.upcase %></span>
    </div>
    <div>
      <span class="text-sm font-semibold text-gray-900"><%= comment.name %></span>
      <span class="text-xs text-gray-400 ml-2"><%= time_ago_in_words(comment.created_at) %> ago</span>
    </div>
  </div>
  <p class="text-sm text-gray-600 leading-relaxed ml-11"><%= comment.body %></p>
</div>
