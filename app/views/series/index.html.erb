<% content_for(:title) { "Series — Boaner" } %>

<!-- Hero Header -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0">
    <img src="https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=1920&q=80&auto=format&fit=crop" alt="" class="w-full h-full object-cover">
    <div class="absolute inset-0 bg-gray-950/85"></div>
  </div>
  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 py-16 md:py-20">
    <h1 class="text-4xl md:text-5xl font-bold text-white" style="font-family: 'Source Serif 4', Georgia, serif;">Series</h1>
    <p class="mt-3 text-gray-300 text-lg">Curated video playlists and multi-part deep dives.</p>
    <div class="w-16 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full mt-4"></div>
  </div>
</section>

<section class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 py-12 md:py-16">
  <% if @series.any? %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @series.each do |s| %>
        <%= link_to series_path(s), class: "group block bg-white rounded-xl border border-gray-100 hover:border-amber-200 hover:shadow-lg transition-all duration-300 overflow-hidden" do %>
          <% first_video = s.videos.first %>
          <% if first_video %>
            <div class="aspect-video bg-gray-100 overflow-hidden">
              <img src="<%= first_video.thumbnail_url_hq %>" alt="<%= s.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
            </div>
          <% else %>
            <div class="aspect-video bg-gradient-to-br from-gray-900 to-gray-800 flex items-center justify-center">
              <svg class="w-12 h-12 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            </div>
          <% end %>
          <div class="p-5">
            <h3 class="text-base font-bold text-gray-900 group-hover:text-amber-600 transition-colors" style="font-family: 'Source Serif 4', Georgia, serif;"><%= s.title %></h3>
            <p class="mt-1 text-xs text-gray-400 font-medium"><%= s.videos.count %> video<%= s.videos.count == 1 ? '' : 's' %></p>
            <% if s.description.present? %>
              <p class="mt-2 text-sm text-gray-500 line-clamp-2"><%= s.description %></p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 bg-gray-50 rounded-2xl">
      <p class="text-gray-400 font-medium">No series yet.</p>
    </div>
  <% end %>
</section>
